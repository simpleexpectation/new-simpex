.orb {
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-radius: 999rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 30% 30%, rgba(226, 220, 186, 0.5), rgba(141, 166, 207, 0.24) 40%, rgba(255, 255, 255, 0.06) 68%, rgba(255, 255, 255, 0.02) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow:
    0 0 40rpx rgba(212, 204, 182, 0.12),
    inset 0 0 30rpx rgba(255, 255, 255, 0.08);
}

.orb__label {
  color: #f3f1e7;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.orb__hint {
  margin-top: 8rpx;
  color: rgba(243, 241, 231, 0.6);
  font-size: 20rpx;
  text-align: center;
}
