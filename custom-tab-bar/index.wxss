.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 20;
}

.tab-bar__mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(18rpx);
}

.tab-bar__fab {
  position: absolute;
  right: 8rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  width: 94rpx;
  height: 94rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(243, 241, 231, 0.14);
  backdrop-filter: blur(18rpx);
  color: #f3f1e7;
  box-shadow:
    0 18rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.tab-bar__fab--active {
  background: rgba(239, 223, 191, 0.22);
}

.tab-bar__fab-icon {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 300;
}

.tab-bar__composer {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  padding: 30rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at top right, rgba(246, 225, 180, 0.18), transparent 32%),
    radial-gradient(circle at 14% 22%, rgba(170, 198, 255, 0.12), transparent 24%),
    rgba(16, 16, 18, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.36);
}

.tab-bar__composer-title {
  display: block;
  color: #f3f1e7;
  font-size: 34rpx;
  font-weight: 600;
}

.tab-bar__composer-sub {
  display: block;
  margin-top: 10rpx;
  margin-bottom: 20rpx;
  color: rgba(243, 241, 231, 0.62);
  font-size: 22rpx;
  line-height: 1.6;
}

.tab-bar__composer-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.tab-bar__composer-card--self {
  background:
    radial-gradient(circle at 88% 18%, rgba(247, 230, 156, 0.18), transparent 22%),
    rgba(255, 255, 255, 0.045);
}

.tab-bar__composer-card--direct {
  background:
    radial-gradient(circle at 86% 18%, rgba(171, 198, 255, 0.16), transparent 24%),
    rgba(255, 255, 255, 0.04);
}

.tab-bar__composer-card + .tab-bar__composer-card {
  margin-top: 14rpx;
}

.tab-bar__composer-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.tab-bar__composer-badge {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(243, 241, 231, 0.66);
  font-size: 18rpx;
  display: flex;
  align-items: center;
}

.tab-bar__composer-arrow {
  color: rgba(243, 241, 231, 0.34);
  font-size: 30rpx;
}

.tab-bar__composer-label {
  color: #f3f1e7;
  font-size: 30rpx;
  font-weight: 600;
}

.tab-bar__composer-copy {
  color: rgba(243, 241, 231, 0.62);
  font-size: 22rpx;
  line-height: 1.5;
}

.tab-bar__rail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 18rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(96, 59, 20, 0.18), rgba(0, 0, 0, 0)),
    #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0 10rpx;
  color: rgba(243, 241, 231, 0.42);
}

.tab-bar__item--active {
  color: #f3f1e7;
}

.tab-bar__icon {
  font-size: 28rpx;
}

.tab-bar__text {
  font-size: 20rpx;
}
