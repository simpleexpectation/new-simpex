.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 20;
}

.tab-bar__mask {
  position: fixed;
  inset: 0;
}

.tab-bar__mask {
  background: rgba(0, 0, 0, 0.36);
  backdrop-filter: blur(8rpx);
}

.tab-bar__fab {
  position: absolute;
  right: 8rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  width: 94rpx;
  height: 94rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(243, 241, 231, 0.14);
  backdrop-filter: blur(18rpx);
  color: #f3f1e7;
  box-shadow:
    0 18rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.tab-bar__fab-icon {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 300;
}

.tab-bar__composer {
  position: fixed;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  width: min(640rpx, calc(100vw - 72rpx));
  padding: 26rpx 24rpx 22rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 86% 14%, rgba(246, 231, 177, 0.16), transparent 24%),
    linear-gradient(180deg, rgba(241, 239, 234, 0.97), rgba(237, 232, 225, 0.97) 58%, rgba(233, 227, 218, 0.96) 100%);
  box-shadow: 0 28rpx 90rpx rgba(0, 0, 0, 0.34);
  z-index: 21;
}

.tab-bar__composer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.tab-bar__composer-title {
  display: block;
  color: #171312;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  line-height: 1.16;
  max-width: 520rpx;
}

.tab-bar__composer-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(23, 19, 18, 0.05);
  color: rgba(23, 19, 18, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
}

.tab-bar__composer-body {
  position: relative;
  overflow: hidden;
  margin-top: 16rpx;
  padding: 8rpx 0 0;
  border-radius: 0;
  background: transparent;
}

.tab-bar__composer-input-head,
.tab-bar__composer-textarea,
.tab-bar__composer-chips {
  position: relative;
  z-index: 1;
}

.tab-bar__composer-input-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.tab-bar__composer-voice {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.34);
  color: rgba(23, 19, 18, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.tab-bar__composer-textarea {
  width: 100%;
  height: 136rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(246, 230, 171, 0.2), transparent 22%),
    linear-gradient(180deg, rgba(233, 216, 201, 0.96), rgba(241, 222, 195, 0.96));
  color: #171312;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.7;
  letter-spacing: 0.2rpx;
  position: relative;
  z-index: 1;
}

.tab-bar__composer-placeholder {
  color: rgba(23, 19, 18, 0.24);
}

.tab-bar__composer-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tab-bar__composer-chip {
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: rgba(23, 19, 18, 0.42);
  display: inline-flex;
  align-items: center;
  font-size: 17rpx;
}

.tab-bar__composer-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 3;
}

.tab-bar__composer-secondary,
.tab-bar__composer-primary {
  min-height: 74rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  border: 0;
  line-height: 74rpx;
}

.tab-bar__composer-secondary {
  flex: 1;
  background: rgba(23, 19, 18, 0.05);
  color: rgba(23, 19, 18, 0.64);
}

.tab-bar__composer-primary {
  flex: 1.1;
  background: linear-gradient(135deg, #f6e8c3, #f1d382);
  color: #17130f;
}

.tab-bar__rail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 18rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(96, 59, 20, 0.18), rgba(0, 0, 0, 0)),
    #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0 10rpx;
  color: rgba(243, 241, 231, 0.42);
}

.tab-bar__item--active {
  color: #f3f1e7;
}

.tab-bar__icon {
  font-size: 28rpx;
}

.tab-bar__text {
  font-size: 20rpx;
}
