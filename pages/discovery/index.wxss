.discovery-page {
  position: relative;
}

.discovery-page__top-mask {
  position: fixed;
  z-index: 8;
  pointer-events: none;
  left: 0;
  right: 0;
  top: 0;
  height: 220rpx;
  background: linear-gradient(180deg, #000000 54%, rgba(0, 0, 0, 0));
}

/* ── 日历容器 ── */
.calendar-wrap {
  position: relative;
  z-index: 9;
  margin-top: 10rpx;
  padding: 0 6rpx;
}

/* ── 本周横排 ── */
.calendar-row {
  display: flex;
  justify-content: space-between;
}

.calendar-row__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.calendar-row__week {
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.calendar-row__dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--panel-soft);
  color: var(--text-secondary);
  font-size: 22rpx;
}

.calendar-row__dot--active {
  background: radial-gradient(circle at 50% 40%, #eff0bd, #cfd29f);
  color: #111111;
}

.calendar-row__dot--warm {
  background: radial-gradient(circle at 50% 40%, #f5d8b8, #f0b88a);
  color: #111111;
}

/* 有活动的日期小圆点指示器 */
.calendar-row__event-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--warm);
}

.calendar-row__event-dot--hidden {
  background: transparent;
}

/* ── 整月网格（展开态，默认 max-height:0 隐藏） ── */
.calendar-month {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.38s cubic-bezier(0.4, 0, 0.2, 1);
}

.calendar-wrap--expanded .calendar-month {
  max-height: 660rpx;
}

.calendar-month__top {
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid var(--line);
  margin-top: 18rpx;
}

.calendar-month__label {
  color: var(--text-tertiary);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.calendar-month__header {
  display: flex;
  padding: 14rpx 0 8rpx;
}

.calendar-month__wday {
  flex: 1;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 20rpx;
}

.calendar-month__week {
  display: flex;
  margin-bottom: 8rpx;
}

.calendar-month__cell {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 3rpx 0;
}

/* 月视图的日期圆点，比周视图稍小以适应 7 列 */
.calendar-month__day-dot {
  width: 62rpx;
  height: 62rpx;
  font-size: 22rpx;
}

.calendar-month__day-empty {
  width: 62rpx;
  height: 62rpx;
}

/* ── 展开/收起手柄 ── */
.calendar-toggle {
  display: flex;
  justify-content: center;
  padding: 18rpx 0 4rpx;
}

.calendar-toggle__chevron {
  width: 22rpx;
  height: 22rpx;
  border-right: 2rpx solid var(--text-tertiary);
  border-bottom: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg) translateY(-4rpx);
  transition: transform 0.3s ease;
}

.calendar-toggle__chevron--up {
  transform: rotate(225deg) translateY(-4rpx);
}

/* ── 活动卡片列表 ── */
.activity-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 28rpx;
  padding: 24rpx 0 120rpx;
}

.activity-card {
  position: relative;
  overflow: hidden;
  min-height: 520rpx;
  padding: 26rpx 28rpx 30rpx;
  border-radius: 52rpx;
}

.activity-card--0 {
  background: linear-gradient(180deg, #738087, #c8beb7 76%, #c19a76 100%);
}

.activity-card--1 {
  background: linear-gradient(180deg, #dedcef, #efe9e2 72%, #ff8a00 100%);
}

.activity-card--2 {
  background: linear-gradient(180deg, #3f7657, #4f8c69 56%, #8ee6a0 100%);
}

.activity-card__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(32rpx);
  animation: drift 8s ease-in-out infinite;
}

.activity-card__mist--a {
  top: -30rpx;
  right: 30rpx;
  width: 280rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.18);
}

.activity-card__mist--b {
  left: 40rpx;
  bottom: 30rpx;
  width: 300rpx;
  height: 200rpx;
  background: rgba(255, 195, 157, 0.24);
  animation-delay: -2.2s;
}

.activity-card__header,
.activity-card__body,
.activity-card__footer {
  position: relative;
  z-index: 2;
}

.activity-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.activity-card__seat {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.activity-card__body {
  display: flex;
  flex-direction: column;
  min-height: 340rpx;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.activity-card__title {
  width: 420rpx;
  color: #ffffff;
  font-size: 58rpx;
  line-height: 1.06;
  letter-spacing: -2rpx;
  font-weight: 600;
}

.activity-card__meta {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.activity-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}
