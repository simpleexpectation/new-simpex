.starter-page {
  position: relative;
  overflow: hidden;
}

.starter-page__glow {
  position: fixed;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
  opacity: 0.6;
}

.starter-page__glow--a {
  width: 360rpx;
  height: 320rpx;
  top: 180rpx;
  right: -60rpx;
  background: rgba(248, 213, 157, 0.18);
}

.starter-page__glow--b {
  width: 300rpx;
  height: 260rpx;
  left: -40rpx;
  top: 520rpx;
  background: rgba(158, 187, 236, 0.16);
}

.starter-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.starter-nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.starter-nav__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.starter-nav__title {
  color: #f3f1e7;
  font-size: 40rpx;
  font-weight: 600;
}

.starter-nav__sub {
  color: rgba(243, 241, 231, 0.48);
  font-size: 20rpx;
}

.starter-progress {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.starter-progress__item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.starter-progress__dot {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.starter-progress__dot--active {
  background: linear-gradient(90deg, #f2e0b3, #f4c89e);
}

.starter-progress__label {
  color: rgba(243, 241, 231, 0.32);
  font-size: 18rpx;
  line-height: 1.4;
}

.starter-progress__label--active {
  color: rgba(243, 241, 231, 0.72);
}

.starter-section {
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.starter-hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.starter-hero__eyebrow,
.section-head__eyebrow {
  color: rgba(243, 241, 231, 0.42);
  font-size: 18rpx;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}

.starter-hero__title,
.section-head__title {
  color: #f3f1e7;
  font-size: 58rpx;
  line-height: 1.06;
  letter-spacing: -1.8rpx;
  font-weight: 600;
}

.starter-hero__copy,
.section-head__copy {
  color: rgba(243, 241, 231, 0.7);
  font-size: 26rpx;
  line-height: 1.7;
}

.starter-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.upload-dropzone {
  padding: 28rpx;
  border-radius: 32rpx;
}

.upload-dropzone__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.upload-dropzone__title {
  color: #f3f1e7;
  font-size: 30rpx;
  font-weight: 600;
}

.upload-dropzone__action {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f3f1e7;
  font-size: 20rpx;
}

.upload-dropzone__copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(243, 241, 231, 0.66);
  font-size: 22rpx;
  line-height: 1.7;
}

.upload-card {
  min-height: 188rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.upload-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.upload-card--warm {
  background: linear-gradient(145deg, rgba(216, 175, 115, 0.22), rgba(255, 255, 255, 0.04));
}

.upload-card--mist {
  background: linear-gradient(145deg, rgba(150, 171, 214, 0.2), rgba(255, 255, 255, 0.04));
}

.upload-card--glow {
  background: linear-gradient(145deg, rgba(218, 205, 150, 0.2), rgba(255, 255, 255, 0.04));
}

.upload-card--selected {
  box-shadow: 0 0 0 2rpx rgba(244, 221, 175, 0.34);
}

.upload-card__source {
  color: rgba(243, 241, 231, 0.52);
  font-size: 20rpx;
}

.upload-card__badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #f3f1e7;
  font-size: 18rpx;
}

.upload-card__caption {
  margin-top: 14rpx;
  color: #f3f1e7;
  font-size: 34rpx;
  line-height: 1.3;
}

.upload-card__state {
  margin-top: 20rpx;
  color: rgba(243, 241, 231, 0.7);
  font-size: 22rpx;
}

.starter-note {
  padding: 28rpx;
  border-radius: 30rpx;
}

.starter-note__title {
  display: block;
  color: #f3f1e7;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.starter-note__line {
  display: block;
  color: rgba(243, 241, 231, 0.64);
  font-size: 24rpx;
  line-height: 1.9;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.insight-list,
.topic-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.insight-card {
  padding: 26rpx;
  border-radius: 30rpx;
}

.insight-card__title {
  display: block;
  color: rgba(243, 241, 231, 0.42);
  font-size: 20rpx;
}

.insight-card__value {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 30rpx;
  line-height: 1.6;
}

.starter-topic {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-radius: 46rpx;
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
}

.starter-topic--0 {
  background:
    radial-gradient(circle at 74% 18%, rgba(251, 240, 183, 0.42), transparent 22%),
    radial-gradient(circle at 28% 74%, rgba(232, 188, 160, 0.28), transparent 28%),
    linear-gradient(135deg, #98a9b6 0%, #c7b2aa 40%, #e5c79c 100%);
}

.starter-topic--1 {
  background:
    radial-gradient(circle at 24% 18%, rgba(247, 205, 170, 0.4), transparent 22%),
    radial-gradient(circle at 78% 70%, rgba(205, 234, 172, 0.26), transparent 26%),
    linear-gradient(135deg, #c8c6e0 0%, #dcc7b7 46%, #c6dfac 100%);
}

.starter-topic--2 {
  background:
    radial-gradient(circle at 70% 22%, rgba(241, 230, 173, 0.28), transparent 22%),
    linear-gradient(180deg, #4c6c67, #7d8f87 60%, #d9c0ad 100%);
}

.starter-topic--selected {
  box-shadow:
    0 0 0 2rpx rgba(255, 255, 255, 0.22),
    0 18rpx 42rpx rgba(0, 0, 0, 0.24);
}

.starter-topic__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(32rpx);
}

.starter-topic__mist--a {
  top: -30rpx;
  right: 30rpx;
  width: 280rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.16);
}

.starter-topic__mist--b {
  left: 40rpx;
  bottom: 30rpx;
  width: 300rpx;
  height: 200rpx;
  background: rgba(255, 195, 157, 0.16);
}

.starter-topic__header,
.starter-topic__body,
.starter-topic__openers,
.starter-topic__footer {
  position: relative;
  z-index: 1;
}

.starter-topic__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.starter-topic__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.starter-topic__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.82);
}

.starter-topic__status-label,
.starter-topic__seat {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.starter-topic__body {
  flex: 1;
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.starter-topic__depth {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.84);
  font-size: 18rpx;
  align-self: flex-start;
}

.starter-topic__title {
  display: block;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 46rpx;
  line-height: 1.12;
  font-weight: 600;
}

.starter-topic__meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-top: 16rpx;
}

.starter-topic__initiator {
  color: rgba(255, 255, 255, 0.95);
  font-size: 24rpx;
  font-weight: 600;
}

.starter-topic__meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.starter-topic__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.starter-topic__pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
}

.starter-topic__reason {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
  line-height: 1.7;
}

.starter-topic__openers {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.starter-topic__opener {
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  line-height: 1.6;
}

.starter-topic__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.starter-topic__rules {
  flex: 1;
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  line-height: 1.5;
}

.starter-topic__select {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #111111;
  font-size: 22rpx;
  font-weight: 600;
}

.launch-card {
  padding: 28rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(248, 219, 170, 0.18), transparent 22%),
    rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.launch-card__title {
  display: block;
  color: rgba(243, 241, 231, 0.42);
  font-size: 20rpx;
}

.launch-card__title--sub {
  margin-top: 24rpx;
}

.launch-card__topic {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 600;
}

.auto-fill-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.edit-zone {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.edit-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.edit-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.edit-card__label {
  color: #f3f1e7;
  font-size: 24rpx;
  font-weight: 600;
}

.edit-card__hint {
  color: rgba(243, 241, 231, 0.42);
  font-size: 20rpx;
}

.auto-fill-item {
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
}

.auto-fill-item__label {
  display: block;
  color: rgba(243, 241, 231, 0.42);
  font-size: 20rpx;
}

.auto-fill-item__value {
  display: block;
  margin-top: 10rpx;
  color: #f3f1e7;
  font-size: 26rpx;
  line-height: 1.55;
}

.audience-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.launch-preview {
  padding: 2rpx 0 0;
}

.launch-preview__copy {
  display: block;
  color: #f3f1e7;
  font-size: 26rpx;
  line-height: 1.7;
}

.publish-note {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.publish-note__title {
  display: block;
  color: #f3f1e7;
  font-size: 24rpx;
  font-weight: 600;
}

.publish-note__copy {
  display: block;
  margin-top: 10rpx;
  color: rgba(243, 241, 231, 0.68);
  font-size: 22rpx;
  line-height: 1.7;
}

.success-card {
  padding: 30rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 84% 14%, rgba(242, 226, 173, 0.2), transparent 20%),
    radial-gradient(circle at 16% 88%, rgba(168, 194, 255, 0.14), transparent 22%),
    rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.success-card__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.44);
  font-size: 18rpx;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
}

.success-card__title {
  display: block;
  margin-top: 16rpx;
  color: #f3f1e7;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 600;
}

.success-card__status {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(243, 241, 231, 0.76);
  font-size: 22rpx;
}

.success-card__section {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.success-card__label {
  display: block;
  color: rgba(243, 241, 231, 0.42);
  font-size: 20rpx;
}

.success-card__copy {
  display: block;
  margin-top: 10rpx;
  color: #f3f1e7;
  font-size: 24rpx;
  line-height: 1.7;
}

.success-card__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.success-card__meta {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.success-card__meta-label {
  display: block;
  color: rgba(243, 241, 231, 0.42);
  font-size: 20rpx;
}

.success-card__meta-value {
  display: block;
  margin-top: 10rpx;
  color: #f3f1e7;
  font-size: 24rpx;
  line-height: 1.5;
}

.success-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.audience-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.58);
  font-size: 22rpx;
}

.audience-pill--active {
  background: rgba(244, 219, 173, 0.18);
  color: #f3f1e7;
}

.launch-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.launch-action {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #f3f1e7;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.05);
}

.launch-action--primary {
  background: linear-gradient(135deg, #f1e1b8, #e9c39b);
  color: #17130f;
  font-weight: 600;
}

.result-card {
  padding: 28rpx;
  border-radius: 34rpx;
}

.result-card__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.38);
  font-size: 18rpx;
  text-transform: uppercase;
  letter-spacing: 1.4rpx;
}

.result-card__title {
  display: block;
  margin-top: 14rpx;
  color: #f3f1e7;
  font-size: 36rpx;
  font-weight: 600;
}

.result-card__copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(243, 241, 231, 0.7);
  font-size: 24rpx;
  line-height: 1.8;
}

.result-card__meta {
  display: block;
  margin-top: 16rpx;
  color: rgba(243, 241, 231, 0.46);
  font-size: 20rpx;
  line-height: 1.6;
}

.starter-footer {
  position: sticky;
  bottom: 26rpx;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 16rpx;
  margin-top: 36rpx;
}

.starter-footer__secondary,
.starter-footer__primary {
  min-height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.starter-footer__secondary {
  background: rgba(255, 255, 255, 0.05);
  color: #f3f1e7;
}

.starter-footer__primary {
  background: linear-gradient(135deg, #f0dfb7, #e8be98);
  color: #17130f;
  font-weight: 600;
}
