.direct-launch-page {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 10%, rgba(245, 231, 141, 0.22), transparent 24%),
    radial-gradient(circle at 18% 18%, rgba(174, 202, 229, 0.18), transparent 24%),
    radial-gradient(circle at 20% 72%, rgba(236, 181, 136, 0.18), transparent 24%),
    linear-gradient(180deg, #1d1712 0%, #1a1418 42%, #17151d 100%);
}

.direct-launch-page__glow {
  position: fixed;
  border-radius: 50%;
  filter: blur(96rpx);
  pointer-events: none;
  opacity: 0.72;
}

.direct-launch-page__glow--a {
  width: 420rpx;
  height: 340rpx;
  top: 120rpx;
  right: -40rpx;
  background: rgba(243, 224, 144, 0.24);
}

.direct-launch-page__glow--b {
  width: 340rpx;
  height: 300rpx;
  left: -20rpx;
  top: 720rpx;
  background: rgba(166, 199, 228, 0.18);
}

.direct-launch-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.direct-launch-nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.direct-launch-nav__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.direct-launch-nav__title {
  color: #f3f1e7;
  font-size: 40rpx;
  font-weight: 600;
}

.direct-launch-nav__sub {
  color: rgba(243, 241, 231, 0.5);
  font-size: 20rpx;
  line-height: 1.45;
}

.launch-mode {
  margin-top: 28rpx;
  display: flex;
  gap: 12rpx;
}

.launch-mode__item {
  flex: 1;
  min-height: 116rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10rpx;
  background:
    radial-gradient(circle at 84% 18%, rgba(243, 229, 146, 0.08), transparent 24%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.launch-mode__item--active {
  background:
    radial-gradient(circle at 84% 18%, rgba(243, 229, 146, 0.18), transparent 22%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06));
  border-color: rgba(243, 229, 146, 0.16);
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.12);
}

.launch-mode__label {
  color: #f3f1e7;
  font-size: 28rpx;
  font-weight: 600;
}

.launch-mode__hint {
  color: rgba(243, 241, 231, 0.56);
  font-size: 20rpx;
  line-height: 1.5;
}

.launch-card {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  min-height: 820rpx;
  padding: 36rpx;
  border-radius: 56rpx;
  background:
    radial-gradient(circle at 78% 14%, rgba(248, 232, 131, 0.58), transparent 22%),
    radial-gradient(circle at 22% 82%, rgba(241, 153, 110, 0.26), transparent 28%),
    linear-gradient(180deg, #b8c8d7 0%, #d6b7a7 52%, #f0cf7b 100%);
  box-shadow: 0 34rpx 84rpx rgba(0, 0, 0, 0.24);
}

.launch-card__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(34rpx);
}

.launch-card__mist--a {
  top: -18rpx;
  right: 18rpx;
  width: 220rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.18);
}

.launch-card__mist--b {
  left: 18rpx;
  bottom: 26rpx;
  width: 240rpx;
  height: 170rpx;
  background: rgba(255, 206, 176, 0.16);
}

.launch-card__eyebrow,
.launch-card__title,
.launch-card__copy,
.launch-card__grid {
  position: relative;
  z-index: 1;
}

.launch-card__eyebrow {
  display: block;
  color: rgba(23, 19, 18, 0.46);
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
}

.launch-card__title {
  display: block;
  margin-top: 18rpx;
  color: #171312;
  font-size: 70rpx;
  line-height: 1.04;
  font-weight: 600;
}

.launch-card__copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(23, 19, 18, 0.66);
  font-size: 26rpx;
  line-height: 1.7;
}

.launch-card__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 32rpx;
}

.launch-card__cell {
  min-height: 160rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(23, 19, 18, 0.08);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.launch-card__cell--wide {
  grid-column: 1 / -1;
}

.launch-card__label {
  color: rgba(23, 19, 18, 0.42);
  font-size: 18rpx;
}

.launch-card__value {
  color: #171312;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
}

.launch-card__input,
.launch-card__textarea {
  width: 100%;
  color: #171312;
  font-size: 28rpx;
  line-height: 1.6;
  background: transparent;
  border: 0;
  padding: 0;
  box-sizing: border-box;
}

.launch-card__textarea {
  min-height: 88rpx;
}

.launch-card__textarea--title {
  min-height: 72rpx;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
}

.launch-card__placeholder {
  color: rgba(23, 19, 18, 0.32);
}

.launch-note {
  margin-top: 18rpx;
  padding: 0 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.launch-note__label {
  color: rgba(243, 241, 231, 0.42);
  font-size: 18rpx;
}

.launch-note__copy {
  color: rgba(243, 241, 231, 0.68);
  font-size: 22rpx;
  line-height: 1.6;
}

.direct-launch-footer {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
}

.direct-launch-footer__ghost,
.direct-launch-footer__primary {
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.direct-launch-footer__ghost {
  flex: 1;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  color: rgba(243, 241, 231, 0.86);
}

.direct-launch-footer__primary {
  flex: 1.15;
  background: linear-gradient(135deg, #f1e1b8, #edc680);
  color: #17130f;
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.16);
}
