.person-page {
  position: relative;
}

.person-nav {
  display: flex;
  justify-content: flex-start;
  margin-top: 18rpx;
}

.person-nav__back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.78);
  font-size: 22rpx;
}

.person-hero {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  margin-bottom: 30rpx;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 82% 16%, rgba(198, 213, 255, 0.2), transparent 22%),
    radial-gradient(circle at 18% 78%, rgba(248, 224, 168, 0.16), transparent 22%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.person-hero__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(42rpx);
}

.person-hero__glow--a {
  top: -28rpx;
  right: 24rpx;
  width: 200rpx;
  height: 180rpx;
  background: rgba(182, 198, 255, 0.2);
}

.person-hero__glow--b {
  left: -24rpx;
  bottom: -30rpx;
  width: 180rpx;
  height: 150rpx;
  background: rgba(245, 214, 164, 0.12);
}

.person-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #707c82, #c6bbb2 55%, #c19a76);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.person-avatar__initial {
  font-size: 56rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
}

.person-name {
  display: block;
  margin-top: 24rpx;
  font-size: 78rpx;
  line-height: 0.95;
  letter-spacing: -2rpx;
  font-weight: 700;
  color: #f3f1e7;
  position: relative;
  z-index: 1;
}

.person-bio-lines {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  position: relative;
  z-index: 1;
}

.person-bio-line {
  color: rgba(243, 241, 231, 0.78);
  font-size: 26rpx;
  line-height: 1.5;
}

.person-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
  position: relative;
  z-index: 1;
}

.person-tags .pill {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.88);
}

.person-section-head {
  margin-bottom: 16rpx;
}

.person-section-head__title {
  display: block;
  color: rgba(243, 241, 231, 0.72);
  font-size: 26rpx;
}

.person-section-head__copy {
  display: block;
  margin-top: 8rpx;
  color: rgba(243, 241, 231, 0.48);
  font-size: 24rpx;
  line-height: 1.7;
}

.person-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.person-fragment {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

.person-fragment--tall {
  height: 320rpx;
}

.person-fragment--wide {
  grid-column: span 2;
  height: 240rpx;
}

.person-art--dusk {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.42) 100%),
    linear-gradient(180deg, #738087, #c8beb7 76%, #c19a76 100%);
}

.person-art--forest {
  background:
    linear-gradient(180deg, transparent 35%, rgba(0,0,0,0.44) 100%),
    linear-gradient(180deg, #3f7657, #4f8c69 56%, #8ee6a0 100%);
}

.person-art--paper {
  background: linear-gradient(180deg, #eef0f6, #dfe3ef);
}

.person-art--mist {
  background: linear-gradient(180deg, #d4d8e2, #c6ccd8);
}

.person-art--warm {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.46) 100%),
    linear-gradient(180deg, #cfd3ea, #e5dfed 72%, #ecbf95 100%);
}

.person-fragment__body {
  position: absolute;
  inset: 0;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.person-fragment__body--text {
  background: rgba(248, 248, 250, 0.84);
  backdrop-filter: blur(20rpx);
}

.person-fragment__eyebrow {
  font-size: 18rpx;
  color: rgba(243, 241, 231, 0.62);
}

.person-fragment__body--text .person-fragment__eyebrow,
.person-fragment__body--text .person-fragment__meta {
  color: rgba(28, 30, 36, 0.5);
}

.person-fragment__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.person-fragment__body--text .person-fragment__title {
  color: #1d1d21;
}

.person-fragment__meta {
  font-size: 22rpx;
  color: rgba(243, 241, 231, 0.74);
  line-height: 1.45;
}

.person-event-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.58);
  z-index: 220;
  display: flex;
  align-items: flex-end;
}

.person-event-modal {
  width: 100%;
  border-radius: 42rpx 42rpx 0 0;
  background: #111217;
  padding: 18rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
}

.person-event-modal__handle {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(243, 241, 231, 0.16);
  margin: 0 auto 22rpx;
}

.person-event-modal__hero {
  min-height: 280rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 18%, rgba(198, 213, 255, 0.16), transparent 24%),
    rgba(255, 255, 255, 0.04);
}

.person-event-modal__hero--text {
  background: linear-gradient(180deg, rgba(248, 248, 250, 0.96), rgba(234, 234, 240, 0.9));
}

.person-event-modal__hero-card {
  height: 100%;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.person-event-modal__hero-card--text .person-event-modal__eyebrow,
.person-event-modal__hero-card--text .person-event-modal__meta {
  color: rgba(28, 30, 36, 0.5);
}

.person-event-modal__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.48);
  font-size: 18rpx;
}

.person-event-modal__title {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 600;
}

.person-event-modal__hero-card--text .person-event-modal__title {
  color: #1d1d21;
}

.person-event-modal__meta {
  display: block;
  color: rgba(243, 241, 231, 0.74);
  font-size: 24rpx;
  line-height: 1.55;
}

.person-event-modal__section {
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.person-event-modal__section-label {
  display: block;
  color: rgba(243, 241, 231, 0.44);
  font-size: 20rpx;
}

.person-event-modal__section-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(243, 241, 231, 0.88);
  font-size: 26rpx;
  line-height: 1.7;
}

.person-event-modal__actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.person-event-modal__button {
  min-height: 92rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.person-event-modal__button--primary {
  background: linear-gradient(135deg, #f1eddd, #d8cfb5);
  color: #111111;
  font-weight: 600;
}
