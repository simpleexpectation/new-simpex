<view class="page-shell space-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">
  <view class="space-page__top-mask"></view>

  <nav-shell>
    <view class="tab-switch">
      <view
        class="tab-switch__item {{activeTab === 'online' ? 'tab-switch__item--active' : ''}}"
        bindtap="switchTab"
        data-tab="online"
      >
        <text class="tab-switch__eyebrow">Online</text>
        <text class="tab-switch__label">线上</text>
      </view>
      <view
        class="tab-switch__item {{activeTab === 'reality' ? 'tab-switch__item--active' : ''}}"
        bindtap="switchTab"
        data-tab="reality"
      >
        <text class="tab-switch__eyebrow">Reality</text>
        <text class="tab-switch__label">现实</text>
      </view>
    </view>
  </nav-shell>

  <swiper class="topic-section-swiper topic-section-swiper--{{activeTab}}" current="{{activeTabIndex}}" duration="360" bindchange="onTopicSectionChange">
    <swiper-item>
      <scroll-view scroll-y class="topic-section-scroll">
        <view class="topic-list">
          <view class="topic-calendar-panel glass-panel">
      <view class="topic-calendar-strip">
        <view
          wx:for="{{calendarDays}}"
          wx:key="key"
          class="topic-calendar-strip__dot {{selectedDateKey === item.key ? 'topic-calendar-strip__dot--active' : ''}} {{item.hasTopic ? 'topic-calendar-strip__dot--enabled' : ''}} {{pressedDateKey === item.key ? 'topic-calendar-strip__dot--pressed' : ''}}"
          data-key="{{item.key}}"
          bindtouchstart="pressCalendarDate"
          bindtouchend="releaseCalendarDate"
          bindtouchcancel="releaseCalendarDate"
          bindtap="selectCalendarDate"
        >
          <text class="topic-calendar-strip__weekday">{{item.weekday}}</text>
          <text class="topic-calendar-strip__day">{{item.day}}</text>
        </view>
      </view>

      <view wx:if="{{showCalendar}}" class="topic-calendar-panel__sheet">
        <view class="topic-calendar-panel__grid">
          <view
            wx:for="{{nextWeekDays}}"
            wx:key="key"
            class="topic-calendar-panel__cell {{selectedDateKey === item.key ? 'topic-calendar-panel__cell--active' : ''}} {{item.hasTopic ? 'topic-calendar-panel__cell--enabled' : ''}} {{pressedDateKey === item.key ? 'topic-calendar-panel__cell--pressed' : ''}}"
            data-key="{{item.key}}"
            bindtouchstart="pressCalendarDate"
            bindtouchend="releaseCalendarDate"
            bindtouchcancel="releaseCalendarDate"
            bindtap="selectCalendarDate"
          >
            <text class="topic-calendar-panel__weekday">{{item.weekday}}</text>
            <text class="topic-calendar-panel__day">{{item.day}}</text>
          </view>
        </view>
      </view>

      <view class="topic-calendar-panel__mini-toggle {{pressedToggle ? 'topic-calendar-panel__mini-toggle--pressed' : ''}}" bindtap="toggleCalendar" bindtouchstart="pressCalendarToggle" bindtouchend="releaseCalendarToggle" bindtouchcancel="releaseCalendarToggle">
        <view class="topic-calendar-panel__mini-icon {{showCalendar ? 'topic-calendar-panel__mini-icon--expanded' : ''}}"></view>
      </view>
          </view>

          <view
            wx:for="{{visibleTopics}}"
            wx:key="id"
            class="topic-card topic-card--{{index % 9}} {{pressedTopicId === item.id ? 'topic-card--pressed' : ''}}"
            data-id="{{item.id}}"
            bindtouchstart="pressTopicCard"
            bindtouchend="releaseTopicCard"
            bindtouchcancel="releaseTopicCard"
            bindtap="goTopicDetail"
          >
            <view class="topic-card__mist topic-card__mist--a"></view>
            <view class="topic-card__mist topic-card__mist--b"></view>

            <view class="topic-card__header">
              <view class="topic-card__status">
                <view class="topic-card__dot topic-card__dot--{{item.status}}"></view>
                <text class="topic-card__status-label">{{item.statusLabel}}{{item.status === 'live' ? ' · LIVE' : ''}}</text>
              </view>
              <text class="topic-card__seat">{{item.current}}/{{item.total}} 余 {{item.total - item.current}} 位</text>
            </view>

            <view class="topic-card__body">
              <text class="topic-card__title">{{item.title}}</text>
              <view class="topic-card__meta-row">
                <text class="topic-card__initiator">{{item.initiator}}</text>
                <text class="topic-card__meta"> 发起 · {{item.time}} · {{item.location}}</text>
              </view>
              <view class="topic-card__tags">
                <view wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag" class="pill topic-card__pill">{{tag}}</view>
              </view>
            </view>

            <view class="topic-card__footer">
              <text class="topic-card__rules">{{item.rules}}</text>
              <view class="topic-join-btn {{pressedJoinId === item.id ? 'topic-join-btn--pressed' : ''}}" catchtap="joinTopic" bindtouchstart="pressJoinButton" bindtouchend="releaseJoinButton" bindtouchcancel="releaseJoinButton" data-id="{{item.id}}">申请加入 →</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <view class="topic-section-scroll">
        <view class="reality-page">
          <swiper
            class="reality-swiper"
            current="{{realityCurrent}}"
            vertical
            circular
            bindchange="onRealitySwiperChange"
          >
            <swiper-item wx:for="{{recommendedTopics}}" wx:key="id">
              <view class="reality-slide">
                <view
                  class="reality-card reality-card--{{index % 5}} {{pressedTopicId === item.id ? 'reality-card--pressed' : ''}}"
                  data-id="{{item.id}}"
                  bindtouchstart="pressTopicCard"
                  bindtouchend="releaseTopicCard"
                  bindtouchcancel="releaseTopicCard"
                  bindtap="goTopicDetail"
                >
                  <view class="reality-card__mist reality-card__mist--a"></view>
                  <view class="reality-card__mist reality-card__mist--b"></view>
                  <view class="reality-card__chip">{{item.statusLabel}}</view>
                  <view class="reality-card__body">
                    <text class="reality-card__title">{{item.title}}</text>
                    <text class="reality-card__meta">{{item.initiator}} 发起 · {{item.time}}</text>
                    <text class="reality-card__place">{{item.location}}</text>
                  </view>
                  <view class="reality-card__actions">
                    <view class="reality-card__primary-btn">详情</view>
                    <text class="reality-card__dismiss">不感兴趣</text>
                  </view>
                </view>
              </view>
            </swiper-item>
          </swiper>

          <view class="reality-dots">
            <view wx:for="{{recommendedTopics}}" wx:key="id" class="reality-dot {{index === realityCurrent ? 'reality-dot--active' : ''}}"></view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>
