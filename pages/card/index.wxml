<view class="page-shell space-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">
  <view class="space-page__top-mask"></view>

  <nav-shell>
    <view class="tab-switch">
      <view
        class="tab-switch__item {{activeTab === 'topics' ? 'tab-switch__item--active' : ''}}"
        bindtap="switchTab"
        data-tab="topics"
      >
        <text class="tab-switch__eyebrow">Conversations</text>
        <text class="tab-switch__label">对话</text>
      </view>
      <view
        class="tab-switch__item {{activeTab === 'venues' ? 'tab-switch__item--active' : ''}}"
        bindtap="switchTab"
        data-tab="venues"
      >
        <text class="tab-switch__eyebrow">Spaces</text>
        <text class="tab-switch__label">空间</text>
      </view>
    </view>
  </nav-shell>

  <!-- ── 话题列表 ── -->
  <view wx:if="{{activeTab === 'topics'}}" class="topic-list">
    <view class="ai-entry-card" bindtap="openAiEntry">
      <view class="ai-entry-card__mist ai-entry-card__mist--a"></view>
      <view class="ai-entry-card__mist ai-entry-card__mist--b"></view>
      <view class="ai-entry-card__head">
        <text class="ai-entry-card__eyebrow">First conversation with AI</text>
        <text class="ai-entry-card__badge">轻入场</text>
      </view>
      <view class="ai-entry-card__body">
        <text class="ai-entry-card__title">先说一点最近的你</text>
        <text class="ai-entry-card__copy">不用先填资料。先用几句近况、一个想法，做出你的第一张对话卡。</text>
      </view>
      <view class="ai-entry-card__footer">
        <text class="ai-entry-card__hint">支持 3 个问题回答，也可以直接语音说给我听</text>
        <view class="ai-entry-card__action">进入这条轻入场流程 →</view>
      </view>
    </view>

    <view class="topic-calendar-panel glass-panel">
      <view class="topic-calendar-strip">
        <view
          wx:for="{{calendarDays}}"
          wx:key="key"
          class="topic-calendar-strip__dot {{selectedDateKey === item.key ? 'topic-calendar-strip__dot--active' : ''}} {{item.hasTopic ? 'topic-calendar-strip__dot--enabled' : ''}}"
          data-key="{{item.key}}"
          bindtap="selectCalendarDate"
        >
          <text class="topic-calendar-strip__weekday">{{item.weekday}}</text>
          <text class="topic-calendar-strip__day">{{item.day}}</text>
        </view>
      </view>

      <view class="topic-calendar-panel__mini-toggle" bindtap="toggleCalendar">
        <view class="topic-calendar-panel__mini-icon"></view>
      </view>

      <view wx:if="{{showCalendar}}" class="topic-calendar-panel__sheet">
        <view class="topic-calendar-panel__grid">
          <view
            wx:for="{{calendarDays}}"
            wx:key="key"
            class="topic-calendar-panel__cell {{selectedDateKey === item.key ? 'topic-calendar-panel__cell--active' : ''}} {{item.hasTopic ? 'topic-calendar-panel__cell--enabled' : ''}}"
            data-key="{{item.key}}"
            bindtap="selectCalendarDate"
          >
            <text class="topic-calendar-panel__weekday">{{item.weekday}}</text>
            <text class="topic-calendar-panel__day">{{item.day}}</text>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:for="{{visibleTopics}}"
      wx:key="id"
      class="topic-card topic-card--{{index % 9}}"
      data-id="{{item.id}}"
      bindtap="goTopicDetail"
    >
      <view class="topic-card__mist topic-card__mist--a"></view>
      <view class="topic-card__mist topic-card__mist--b"></view>

      <view class="topic-card__header">
        <view class="topic-card__status">
          <view class="topic-card__dot topic-card__dot--{{item.status}}"></view>
          <text class="topic-card__status-label">{{item.statusLabel}}{{item.status === 'live' ? ' · LIVE' : ''}}</text>
        </view>
        <text class="topic-card__seat">{{item.current}}/{{item.total}} 余 {{item.total - item.current}} 位</text>
      </view>

      <view class="topic-card__body">
        <text class="topic-card__title">{{item.title}}</text>
        <view class="topic-card__meta-row">
          <text class="topic-card__initiator">{{item.initiator}}</text>
          <text class="topic-card__meta"> 发起 · {{item.time}} · {{item.location}}</text>
        </view>
        <view class="topic-card__tags">
          <view wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag" class="pill topic-card__pill">{{tag}}</view>
        </view>
      </view>

      <view class="topic-card__footer">
        <text class="topic-card__rules">{{item.rules}}</text>
        <view class="topic-join-btn" catchtap="joinTopic" data-id="{{item.id}}">申请加入 →</view>
      </view>
    </view>

  </view>

  <!-- ── 空间列表 ── -->
  <view wx:if="{{activeTab === 'venues'}}">
    <view class="venue-page-head">
      <text class="venue-page-head__eyebrow">Today in spaces</text>
      <view class="venue-page-head__date">
        <text class="venue-page-head__month">{{venueMonthLabel}}</text>
        <text class="venue-page-head__day">{{venueDayLabel}}日</text>
      </view>
    </view>

    <view class="venue-list">
      <view
        wx:for="{{venues}}"
        wx:key="id"
        class="venue-stage"
        data-id="{{item.id}}"
        bindtap="goVenueDetail"
      >
        <view class="venue-stage__head">
          <text class="venue-stage__caption">{{item.caption}}</text>
        </view>

        <view class="venue-stage__card venue-stage__card--{{index}}">
          <view class="venue-stage__glow"></view>
          <view class="venue-stage__body">
            <text class="venue-stage__eyebrow">{{item.dateCopy}}</text>
            <text class="venue-stage__title">{{item.name}}</text>
            <text class="venue-stage__copy">{{item.mood}}</text>
            <view class="venue-stage__meta">
              <text class="venue-stage__meta-pill">{{item.discount}}</text>
              <text class="venue-stage__meta-pill">{{item.presence}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="venue-recommend-entry" bindtap="openVenueRecommend">
        <view class="venue-recommend-entry__glow"></view>
        <text class="venue-recommend-entry__eyebrow">Co-create a space</text>
        <text class="venue-recommend-entry__title">推荐空间</text>
        <text class="venue-recommend-entry__copy">如果你知道一个适合真实对话发生的地方，也可以推荐给我们。通过官方审核后，它会进入正式空间列表。</text>
        <view class="venue-recommend-entry__footer">
          <text class="venue-recommend-entry__meta">用户推荐 · 官方审核后上线</text>
          <view class="venue-recommend-entry__action">去推荐 →</view>
        </view>
      </view>
    </view>
  </view>
</view>
