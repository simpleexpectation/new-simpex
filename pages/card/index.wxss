.space-page {
  position: relative;
}

.space-page__top-mask {
  position: fixed;
  z-index: 8;
  pointer-events: none;
  left: 0;
  right: 0;
  top: 0;
  height: 220rpx;
  background: linear-gradient(180deg, #000000 54%, rgba(0, 0, 0, 0));
}

/* ── Tab 切换器 ── */
.tab-switch {
  display: flex;
  gap: 32rpx;
  align-items: flex-end;
  padding-top: 8rpx;
}

.tab-switch__item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: rgba(243, 241, 231, 0.24);
  transition: color 0.18s ease, opacity 0.18s ease;
}

.tab-switch__item--active {
  color: #f3f1e7;
}

.tab-switch__label {
  font-size: 78rpx;
  line-height: 0.95;
  letter-spacing: -2rpx;
  font-weight: 600;
}

.tab-switch__eyebrow {
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
  color: rgba(243, 241, 231, 0.34);
}

.tab-switch__item--active .tab-switch__eyebrow {
  color: rgba(243, 241, 231, 0.56);
}

.topic-section-swiper {
  height: calc(100vh - 180rpx);
}

.topic-section-scroll {
  height: 100%;
  box-sizing: border-box;
}

/* ── 话题卡片（同活动卡片风格）── */
.topic-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}

.topic-calendar-panel {
  border-radius: 34rpx;
  padding: 14rpx 16rpx 12rpx;
}

.topic-calendar-strip {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
}

.topic-calendar-strip__weekday {
  color: rgba(243, 241, 231, 0.46);
  font-size: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1;
}

.topic-calendar-strip__dot {
  width: 100%;
  height: 86rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.02);
  transform: translateY(0) scale(1);
  transition: transform 160ms ease, box-shadow 180ms ease, background 180ms ease;
}

.topic-calendar-strip__dot--enabled {
  background: rgba(255, 255, 255, 0.12);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.02),
    0 0 24rpx rgba(255, 255, 255, 0.04);
}

.topic-calendar-strip__dot--active {
  background:
    radial-gradient(circle at 50% 38%, rgba(248, 241, 200, 0.96), rgba(230, 234, 155, 0.88) 62%, rgba(206, 213, 123, 0.9) 100%);
  box-shadow:
    0 0 32rpx rgba(231, 229, 155, 0.34),
    0 0 70rpx rgba(231, 229, 155, 0.14);
}

.topic-calendar-strip__dot--pressed {
  transform: translateY(3rpx) scale(0.97);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.03),
    0 0 18rpx rgba(243, 241, 231, 0.08);
}

.topic-calendar-strip__day {
  color: rgba(243, 241, 231, 0.78);
  font-size: 26rpx;
  line-height: 1;
}

.topic-calendar-strip__dot--active .topic-calendar-strip__weekday {
  color: rgba(31, 27, 24, 0.62);
}

.topic-calendar-strip__dot--active .topic-calendar-strip__day {
  color: #1f1b18;
}

.topic-calendar-panel__mini-toggle {
  margin-top: 14rpx;
  padding-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 160ms ease, opacity 160ms ease;
}

.topic-calendar-panel__mini-toggle--pressed {
  transform: translateY(2rpx) scale(0.96);
  opacity: 0.82;
}

.topic-calendar-panel__mini-icon {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid rgba(243, 241, 231, 0.34);
  filter: drop-shadow(0 0 10rpx rgba(243, 241, 231, 0.08));
  transition: border-color 0.18s ease, transform 0.18s ease;
}

.topic-calendar-panel__mini-icon--expanded {
  border-top: 0 solid transparent;
  border-bottom: 12rpx solid rgba(243, 241, 231, 0.34);
}

.topic-calendar-panel__sheet {
  margin-top: 14rpx;
  animation: calendarDropIn 220ms ease;
}

.topic-calendar-panel__weekday {
  color: rgba(243, 241, 231, 0.4);
  font-size: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1;
}

.topic-calendar-panel__grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
}

.topic-calendar-panel__cell {
  width: 100%;
  height: 86rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.02);
  transform: translateY(0) scale(1);
  transition: transform 160ms ease, box-shadow 180ms ease, background 180ms ease;
}

.topic-calendar-panel__cell--enabled {
  background: rgba(255, 255, 255, 0.06);
}

.topic-calendar-panel__cell--active {
  background: radial-gradient(circle at 50% 46%, rgba(242, 232, 161, 0.96), rgba(222, 227, 145, 0.82));
  box-shadow: 0 0 24rpx rgba(231, 229, 155, 0.24);
}

.topic-calendar-panel__cell--pressed {
  transform: translateY(3rpx) scale(0.97);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.03),
    0 0 18rpx rgba(243, 241, 231, 0.08);
}

.topic-calendar-panel__day {
  color: rgba(243, 241, 231, 0.62);
  font-size: 24rpx;
  line-height: 1;
}

.topic-calendar-panel__cell--active .topic-calendar-panel__weekday,
.topic-calendar-panel__cell--active .topic-calendar-panel__day {
  color: #1f1b18;
}

.topic-card {
  position: relative;
  overflow: hidden;
  min-height: 520rpx;
  padding: 26rpx 28rpx 30rpx;
  border-radius: 52rpx;
  display: flex;
  flex-direction: column;
  transform: translateY(0) scale(1);
  transition: transform 180ms ease, box-shadow 220ms ease, filter 220ms ease;
}

.reality-page {
  margin: 10rpx -32rpx 0;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.reality-swiper {
  height: calc(100vh - 330rpx - env(safe-area-inset-bottom));
  min-height: 1080rpx;
  max-height: 1220rpx;
  margin-top: 0;
}

.reality-slide {
  height: 100%;
  padding: 0;
  box-sizing: border-box;
}

.reality-card {
  position: relative;
  overflow: hidden;
  height: 100%;
  border-radius: 46rpx;
  padding: 40rpx 38rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transform: translateY(0) scale(1);
  box-shadow:
    0 28rpx 84rpx rgba(0, 0, 0, 0.2),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.06);
  transition: transform 180ms ease, box-shadow 220ms ease;
}

.reality-card--pressed {
  transform: translateY(8rpx) scale(0.985);
}

.reality-card--0 {
  background:
    radial-gradient(circle at 78% 16%, rgba(255,245,186,0.22), transparent 20%),
    radial-gradient(circle at 70% 70%, rgba(224, 180, 134, 0.3), transparent 22%),
    linear-gradient(180deg, #687985 0%, #7a8891 56%, #c4aa90 100%);
}

.reality-card--1 {
  background:
    radial-gradient(circle at 82% 12%, rgba(253,231,182,0.2), transparent 18%),
    radial-gradient(circle at 44% 72%, rgba(148, 92, 47, 0.28), transparent 24%),
    linear-gradient(180deg, #2d231d 0%, #6d3516 52%, #c17a35 100%);
}

.reality-card--2 {
  background:
    radial-gradient(circle at 80% 14%, rgba(255, 241, 204, 0.18), transparent 20%),
    radial-gradient(circle at 24% 76%, rgba(234, 188, 153, 0.2), transparent 22%),
    linear-gradient(180deg, #6f665f 0%, #aa8f7d 52%, #d9bea4 100%);
}

.reality-card--3 {
  background:
    radial-gradient(circle at 82% 16%, rgba(255,229,176,0.2), transparent 18%),
    radial-gradient(circle at 38% 78%, rgba(182, 127, 84, 0.24), transparent 20%),
    linear-gradient(180deg, #5d4a44 0%, #99786e 56%, #d0b08e 100%);
}

.reality-card--4 {
  background:
    radial-gradient(circle at 82% 14%, rgba(255,245,186,0.18), transparent 18%),
    radial-gradient(circle at 26% 76%, rgba(200, 143, 121, 0.24), transparent 20%),
    linear-gradient(180deg, #66655d 0%, #8d867e 52%, #c1a78c 100%);
}

.reality-card__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(56rpx);
  pointer-events: none;
}

.reality-card__mist--a {
  right: 12rpx;
  bottom: 168rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(255, 224, 196, 0.3);
}

.reality-card__mist--b {
  left: 28rpx;
  top: 240rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
}

.reality-card__chip {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
}

.reality-card__body {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding-top: 0;
  transform: translateY(-96rpx);
}

.reality-card__title {
  display: block;
  margin-top: 0;
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1.12;
  font-weight: 500;
  letter-spacing: -0.8rpx;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.reality-card__meta,
.reality-card__place {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  line-height: 1.64;
  font-weight: 400;
  letter-spacing: 0.2rpx;
}

.reality-card__actions {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0;
  padding-bottom: 0;
  transform: translateY(-70rpx);
}

.reality-card__primary-btn {
  min-width: 174rpx;
  height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  color: #171312;
  font-size: 28rpx;
  font-weight: 600;
}

.reality-card__dismiss {
  color: rgba(255, 255, 255, 0.68);
  font-size: 25rpx;
  line-height: 1;
}

.reality-dots {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.reality-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(243, 241, 231, 0.18);
  transition: transform 180ms ease, background 180ms ease;
}

.reality-dot--active {
  background: rgba(243, 241, 231, 0.86);
  transform: scale(1.45);
}

.topic-card--pressed {
  transform: translateY(8rpx) scale(0.985);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.18);
  filter: saturate(1.04);
}

.topic-card--0 {
  background:
    radial-gradient(circle at 76% 18%, rgba(248, 232, 131, 0.54), transparent 22%),
    radial-gradient(circle at 24% 78%, rgba(241, 153, 110, 0.3), transparent 28%),
    linear-gradient(180deg, #86a5b7 0%, #b49787 42%, #e5be79 100%);
}

.topic-card--1 {
  background:
    radial-gradient(circle at 76% 22%, rgba(230, 235, 132, 0.46), transparent 24%),
    radial-gradient(circle at 20% 76%, rgba(119, 201, 142, 0.28), transparent 28%),
    linear-gradient(180deg, #82a59b 0%, #8f7d67 54%, #d8bf74 100%);
}

.topic-card--2 {
  background:
    radial-gradient(circle at 72% 20%, rgba(247, 226, 118, 0.42), transparent 22%),
    radial-gradient(circle at 22% 78%, rgba(255, 126, 72, 0.3), transparent 26%),
