  overflow: hidden;
  margin-top: 8rpx;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(243, 232, 130, 0.18), transparent 20%),
    radial-gradient(circle at 20% 80%, rgba(210, 226, 255, 0.14), transparent 22%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.03));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(18rpx);
}

.venue-recommend-entry__glow {
  position: absolute;
  top: -28rpx;
  right: 16rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(243, 232, 130, 0.16), rgba(243, 232, 130, 0));
  filter: blur(18rpx);
}

.venue-recommend-entry__eyebrow,
.venue-recommend-entry__title,
.venue-recommend-entry__copy,
.venue-recommend-entry__footer {
  position: relative;
  z-index: 1;
}

.venue-recommend-entry__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.4);
  font-size: 18rpx;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}

.venue-recommend-entry__title {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 42rpx;
  line-height: 1.04;
  font-weight: 600;
}

.venue-recommend-entry__copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(243, 241, 231, 0.7);
  font-size: 24rpx;
  line-height: 1.65;
}

.venue-recommend-entry__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.venue-recommend-entry__meta {
  color: rgba(243, 241, 231, 0.46);
  font-size: 20rpx;
}

.venue-recommend-entry__action {
  min-width: 164rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  color: #141210;
  font-size: 24rpx;
  font-weight: 600;
}

@keyframes calendarDropIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
