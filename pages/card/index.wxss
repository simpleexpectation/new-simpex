.space-page {
  position: relative;
}

.space-page__top-mask {
  position: fixed;
  z-index: 8;
  pointer-events: none;
  left: 0;
  right: 0;
  top: 0;
  height: 220rpx;
  background: linear-gradient(180deg, #000000 54%, rgba(0, 0, 0, 0));
}

/* ── Tab 切换器 ── */
.tab-switch {
  display: flex;
  gap: 32rpx;
  align-items: flex-end;
  padding-top: 8rpx;
}

.tab-switch__item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: rgba(243, 241, 231, 0.24);
  transition: color 0.18s ease, opacity 0.18s ease;
}

.tab-switch__item--active {
  color: #f3f1e7;
}

.tab-switch__label {
  font-size: 78rpx;
  line-height: 0.95;
  letter-spacing: -2rpx;
  font-weight: 600;
}

.tab-switch__eyebrow {
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
  color: rgba(243, 241, 231, 0.34);
}

.tab-switch__item--active .tab-switch__eyebrow {
  color: rgba(243, 241, 231, 0.56);
}

/* ── 话题卡片（同活动卡片风格）── */
.topic-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}

.ai-entry-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 32rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 80% 18%, rgba(241, 230, 161, 0.22), transparent 22%),
    radial-gradient(circle at 20% 82%, rgba(232, 148, 104, 0.16), transparent 26%),
    linear-gradient(180deg, rgba(133, 165, 183, 0.22) 0%, rgba(180, 151, 135, 0.18) 48%, rgba(229, 190, 121, 0.16) 100%);
  box-shadow:
    0 20rpx 60rpx rgba(0, 0, 0, 0.18),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.ai-entry-card__mist {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
  filter: blur(10rpx);
}

.ai-entry-card__mist--a {
  top: -40rpx;
  right: 56rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(245, 236, 184, 0.22) 0%, rgba(245, 236, 184, 0) 72%);
}

.ai-entry-card__mist--b {
  left: -36rpx;
  bottom: -54rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(245, 167, 132, 0.16) 0%, rgba(245, 167, 132, 0) 72%);
}

.ai-entry-card__head,
.ai-entry-card__body,
.ai-entry-card__footer {
  position: relative;
  z-index: 1;
}

.ai-entry-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ai-entry-card__eyebrow {
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
  color: rgba(243, 241, 231, 0.46);
}

.ai-entry-card__badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(243, 241, 231, 0.8);
  font-size: 20rpx;
  line-height: 1;
}

.ai-entry-card__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.ai-entry-card__title {
  color: #f3f1e7;
  font-size: 52rpx;
  line-height: 1.08;
  letter-spacing: -1rpx;
  font-weight: 600;
}

.ai-entry-card__copy {
  color: rgba(243, 241, 231, 0.72);
  font-size: 28rpx;
  line-height: 1.6;
}

.ai-entry-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
}

.ai-entry-card__hint {
  flex: 1;
  color: rgba(243, 241, 231, 0.46);
  font-size: 22rpx;
  line-height: 1.5;
}

.ai-entry-card__action {
  flex-shrink: 0;
  color: #f3f1e7;
  font-size: 24rpx;
  line-height: 1;
}

.topic-calendar-panel {
  border-radius: 34rpx;
  padding: 14rpx 16rpx 12rpx;
}

.topic-calendar-strip {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
}

.topic-calendar-strip__weekday {
  color: rgba(243, 241, 231, 0.46);
  font-size: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1;
}

.topic-calendar-strip__dot {
  width: 100%;
  height: 86rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.02);
}

.topic-calendar-strip__dot--enabled {
  background: rgba(255, 255, 255, 0.12);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.02),
    0 0 24rpx rgba(255, 255, 255, 0.04);
}

.topic-calendar-strip__dot--active {
  background:
    radial-gradient(circle at 50% 38%, rgba(248, 241, 200, 0.96), rgba(230, 234, 155, 0.88) 62%, rgba(206, 213, 123, 0.9) 100%);
  box-shadow:
    0 0 32rpx rgba(231, 229, 155, 0.34),
    0 0 70rpx rgba(231, 229, 155, 0.14);
}

.topic-calendar-strip__day {
  color: rgba(243, 241, 231, 0.78);
  font-size: 26rpx;
  line-height: 1;
}

.topic-calendar-strip__dot--active .topic-calendar-strip__weekday {
  color: rgba(31, 27, 24, 0.62);
}

.topic-calendar-strip__dot--active .topic-calendar-strip__day {
  color: #1f1b18;
}

.topic-calendar-panel__mini-toggle {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.topic-calendar-panel__mini-icon {
  width: 56rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(243, 241, 231, 0.22);
  box-shadow: 0 0 16rpx rgba(243, 241, 231, 0.06);
}

.topic-calendar-panel__sheet {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  animation: calendarDropIn 220ms ease;
}

.topic-calendar-panel__weekday {
  color: rgba(243, 241, 231, 0.4);
  font-size: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1;
}

.topic-calendar-panel__grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
}

.topic-calendar-panel__cell {
  height: 86rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.02);
}

.topic-calendar-panel__cell--enabled {
  background: rgba(255, 255, 255, 0.06);
}

.topic-calendar-panel__cell--active {
  background: radial-gradient(circle at 50% 46%, rgba(242, 232, 161, 0.96), rgba(222, 227, 145, 0.82));
  box-shadow: 0 0 24rpx rgba(231, 229, 155, 0.24);
}

.topic-calendar-panel__day {
  color: rgba(243, 241, 231, 0.62);
  font-size: 24rpx;
  line-height: 1;
}

.topic-calendar-panel__cell--active .topic-calendar-panel__weekday,
.topic-calendar-panel__cell--active .topic-calendar-panel__day {
  color: #1f1b18;
}

.topic-card {
  position: relative;
  overflow: hidden;
  min-height: 520rpx;
  padding: 26rpx 28rpx 30rpx;
  border-radius: 52rpx;
  display: flex;
  flex-direction: column;
}

.topic-card--0 {
  background:
    radial-gradient(circle at 76% 18%, rgba(248, 232, 131, 0.54), transparent 22%),
    radial-gradient(circle at 24% 78%, rgba(241, 153, 110, 0.3), transparent 28%),
    linear-gradient(180deg, #86a5b7 0%, #b49787 42%, #e5be79 100%);
}

.topic-card--1 {
  background:
    radial-gradient(circle at 76% 22%, rgba(230, 235, 132, 0.46), transparent 24%),
    radial-gradient(circle at 20% 76%, rgba(119, 201, 142, 0.28), transparent 28%),
    linear-gradient(180deg, #82a59b 0%, #8f7d67 54%, #d8bf74 100%);
}

.topic-card--2 {
  background:
    radial-gradient(circle at 72% 20%, rgba(247, 226, 118, 0.42), transparent 22%),
    radial-gradient(circle at 22% 78%, rgba(255, 126, 72, 0.3), transparent 26%),
    linear-gradient(180deg, #2f5958 0%, #7b4e3c 56%, #de9d63 100%);
}

.topic-card--3 {
  background:
    radial-gradient(circle at 74% 20%, rgba(231, 222, 169, 0.22), transparent 22%),
    radial-gradient(circle at 22% 76%, rgba(152, 169, 196, 0.16), transparent 26%),
    linear-gradient(180deg, #98a6b7 0%, #b4ada6 50%, #d0bd9c 100%);
}

.topic-card--4 {
  background:
    radial-gradient(circle at 76% 24%, rgba(239, 228, 130, 0.4), transparent 24%),
    radial-gradient(circle at 24% 80%, rgba(76, 196, 156, 0.24), transparent 28%),
    linear-gradient(180deg, #7da59d 0%, #86736b 54%, #d6a389 100%);
}

.topic-card--5 {
  background:
    radial-gradient(circle at 76% 20%, rgba(247, 232, 123, 0.4), transparent 22%),
    radial-gradient(circle at 20% 78%, rgba(142, 122, 229, 0.24), transparent 26%),
    linear-gradient(180deg, #7d96bb 0%, #95829e 50%, #d5aa76 100%);
}

.topic-card--6 {
  background:
    radial-gradient(circle at 74% 20%, rgba(237, 225, 128, 0.36), transparent 20%),
    radial-gradient(circle at 20% 78%, rgba(62, 186, 214, 0.24), transparent 26%),
    linear-gradient(180deg, #5b7f88 0%, #5d6258 46%, #c49d74 100%);
}

.topic-card--7 {
  background:
    radial-gradient(circle at 76% 24%, rgba(235, 224, 125, 0.34), transparent 24%),
    radial-gradient(circle at 24% 78%, rgba(214, 116, 84, 0.24), transparent 24%),
    linear-gradient(180deg, #bd9381 0%, #a66f5b 52%, #d0a37d 100%);
}

.topic-card--8 {
  background:
    radial-gradient(circle at 74% 20%, rgba(205, 224, 232, 0.24), transparent 22%),
    radial-gradient(circle at 22% 78%, rgba(197, 180, 154, 0.14), transparent 26%),
    linear-gradient(180deg, #a4b6c6 0%, #b4b1a8 54%, #91b3bc 100%);
}

.topic-card__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(32rpx);
  animation: drift 8s ease-in-out infinite;
}

.topic-card__mist--a {
  top: -30rpx;
  right: 30rpx;
  width: 280rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.18);
}

.topic-card__mist--b {
  left: 40rpx;
  bottom: 30rpx;
  width: 300rpx;
  height: 200rpx;
  background: rgba(255, 195, 157, 0.24);
  animation-delay: -2.2s;
}

.topic-card__header,
.topic-card__body,
.topic-card__footer {
  position: relative;
  z-index: 2;
}

.topic-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topic-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.topic-card__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.topic-card__dot--live {
  background: #ffffff;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8);
}

.topic-card__dot--upcoming {
  background: rgba(255, 255, 255, 0.45);
}

.topic-card__status-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.topic-card__seat {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.topic-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.topic-card__title {
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1.08;
  letter-spacing: -1.5rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.topic-card__meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.topic-card__initiator {
  color: rgba(255, 255, 255, 0.95);
  font-size: 26rpx;
  font-weight: 600;
}

.topic-card__meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.topic-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.topic-card__pill {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.topic-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.topic-card__rules {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.topic-join-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
}

/* ── 空间列表 ── */
.venue-page-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
}

.venue-page-head__eyebrow {
  width: 280rpx;
  color: rgba(243, 241, 231, 0.72);
  font-size: 22rpx;
  line-height: 1.35;
}

.venue-page-head__date {
  text-align: right;
}

.venue-page-head__month {
  display: block;
  color: rgba(243, 241, 231, 0.68);
  font-size: 20rpx;
}

.venue-page-head__day {
  display: block;
  margin-top: 4rpx;
  color: #f3f1e7;
  font-size: 112rpx;
  line-height: 0.9;
  letter-spacing: -5rpx;
  font-weight: 300;
}

.venue-list {
  display: flex;
  flex-direction: column;
  gap: 44rpx;
  margin-top: 28rpx;
  padding-bottom: 40rpx;
}

.venue-stage {
  position: relative;
}

.venue-stage__head {
  display: flex;
  align-items: flex-end;
  margin-bottom: 20rpx;
}

.venue-stage__caption {
  width: 340rpx;
  color: rgba(243, 241, 231, 0.8);
  font-size: 22rpx;
  line-height: 1.35;
}

.venue-stage__card {
  position: relative;
  overflow: hidden;
  min-height: 650rpx;
  border-radius: 58rpx;
  box-shadow:
    0 30rpx 90rpx rgba(0, 0, 0, 0.28),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.06);
}

.venue-stage__card--0 {
  background:
    radial-gradient(circle at 74% 18%, rgba(243, 232, 130, 0.72), transparent 20%),
    linear-gradient(180deg, #d6a18d 0%, #d8a38d 100%);
}

.venue-stage__card--1 {
  background:
    radial-gradient(circle at 74% 16%, rgba(212, 234, 165, 0.62), transparent 20%),
    linear-gradient(180deg, #d4c09d 0%, #c7d5a1 100%);
}

.venue-stage__card--2 {
  background:
    radial-gradient(circle at 24% 18%, rgba(208, 228, 240, 0.42), transparent 20%),
    linear-gradient(180deg, #c7c1ca 0%, #ddd1c3 100%);
}

.venue-stage__glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 72% 18%, rgba(255, 255, 255, 0.18), transparent 26%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0));
}

.venue-stage__body {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(19, 16, 15, 0.08), rgba(19, 16, 15, 0.18));
  backdrop-filter: blur(18rpx);
}

.venue-stage__eyebrow {
  display: block;
  color: rgba(23, 19, 18, 0.48);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.venue-stage__title {
  display: block;
  margin-top: 14rpx;
  color: #171312;
  font-size: 58rpx;
  line-height: 1.02;
  font-weight: 600;
}

.venue-stage__copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(23, 19, 18, 0.66);
  font-size: 24rpx;
  line-height: 1.5;
}

.venue-stage__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.venue-stage__meta-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 14, 13, 0.14);
  color: rgba(23, 19, 18, 0.74);
  font-size: 22rpx;
}

.venue-recommend-entry {
  position: relative;
  overflow: hidden;
  margin-top: 8rpx;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(243, 232, 130, 0.18), transparent 20%),
    radial-gradient(circle at 20% 80%, rgba(210, 226, 255, 0.14), transparent 22%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.03));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(18rpx);
}

.venue-recommend-entry__glow {
  position: absolute;
  top: -28rpx;
  right: 16rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(243, 232, 130, 0.16), rgba(243, 232, 130, 0));
  filter: blur(18rpx);
}

.venue-recommend-entry__eyebrow,
.venue-recommend-entry__title,
.venue-recommend-entry__copy,
.venue-recommend-entry__footer {
  position: relative;
  z-index: 1;
}

.venue-recommend-entry__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.4);
  font-size: 18rpx;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}

.venue-recommend-entry__title {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 42rpx;
  line-height: 1.04;
  font-weight: 600;
}

.venue-recommend-entry__copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(243, 241, 231, 0.7);
  font-size: 24rpx;
  line-height: 1.65;
}

.venue-recommend-entry__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.venue-recommend-entry__meta {
  color: rgba(243, 241, 231, 0.46);
  font-size: 20rpx;
}

.venue-recommend-entry__action {
  min-width: 164rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  color: #141210;
  font-size: 24rpx;
  font-weight: 600;
}

@keyframes calendarDropIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
