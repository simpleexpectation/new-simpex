}

.topic-card--7 {
  background:
    radial-gradient(circle at 76% 24%, rgba(235, 224, 125, 0.34), transparent 24%),
    radial-gradient(circle at 24% 78%, rgba(214, 116, 84, 0.24), transparent 24%),
