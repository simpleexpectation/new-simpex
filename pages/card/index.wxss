    linear-gradient(180deg, #7da59d 0%, #86736b 54%, #d6a389 100%);
}

.topic-card--5 {
  background:
    radial-gradient(circle at 76% 20%, rgba(247, 232, 123, 0.4), transparent 22%),
    radial-gradient(circle at 20% 78%, rgba(142, 122, 229, 0.24), transparent 26%),
