.space-page {
  position: relative;
  overflow: hidden;
}

.space-page__bottom-mask {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(-364rpx - env(safe-area-inset-bottom));
  height: 420rpx;
  background: #000000;
  z-index: 8;
  pointer-events: none;
}

.explore-intro {
  margin-top: 24rpx;
}

.explore-intro__copy {
  display: block;
  width: 520rpx;
  margin-top: 0;
  color: rgba(243, 241, 231, 0.56);
  font-size: 24rpx;
  line-height: 1.5;
}

.poster-scroll {
  margin-top: 40rpx;
  white-space: nowrap;
}

.poster-track {
  display: inline-flex;
  gap: 28rpx;
  padding-right: 40rpx;
}

.poster-card {
  width: 330rpx;
}

.poster-card__meta {
  display: block;
  color: rgba(243, 241, 231, 0.54);
  font-size: 20rpx;
}

.poster-card__title {
  display: block;
  margin-top: 8rpx;
  color: #f3f1e7;
  font-size: 50rpx;
  line-height: 1;
}

.poster-card__sub {
  display: block;
  margin-top: 12rpx;
  color: rgba(243, 241, 231, 0.58);
  font-size: 22rpx;
  line-height: 1.5;
}

.poster-card__art {
  height: 380rpx;
  margin-top: 22rpx;
  border-radius: 12rpx;
}

.poster-card__art--earth {
  background:
    radial-gradient(circle at 50% 52%, rgba(255, 112, 35, 0.78), transparent 18%),
    radial-gradient(ellipse at 50% 48%, rgba(56, 37, 15, 0.9), transparent 26%),
    linear-gradient(180deg, #a1aba5, #6a736f);
}

.poster-card__art--sky {
  background:
    radial-gradient(circle at 54% 34%, rgba(242, 151, 229, 0.72), transparent 18%),
    linear-gradient(180deg, #f3dff1, #beb4e8 52%, #b7d0e8);
}

.moment-sheet {
  position: relative;
  overflow: hidden;
  margin-top: 46rpx;
  min-height: 760rpx;
  border-radius: 44rpx;
  padding: 26rpx 26rpx 40rpx;
  background: #dfdbef;
}

.moment-sheet__tag {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 221, 199, 0.62);
  color: #3a2c1a;
  font-size: 22rpx;
}

.moment-sheet__art {
  height: 240rpx;
  margin-top: 24rpx;
  border-top-left-radius: 120rpx;
  border-top-right-radius: 120rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.58), transparent 40%),
    repeating-linear-gradient(180deg, #ff8800 0rpx, #ff8800 16rpx, transparent 16rpx, transparent 54rpx);
}

.moment-sheet__date {
  display: block;
  margin-top: 40rpx;
  color: rgba(32, 27, 26, 0.68);
  font-size: 24rpx;
}

.moment-sheet__title {
  display: block;
  margin-top: 10rpx;
  color: #171414;
  font-size: 48rpx;
  line-height: 1.04;
  font-weight: 600;
}

.moment-sheet__copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(23, 20, 20, 0.76);
  font-size: 26rpx;
  line-height: 1.55;
}
