}

.topic-card--8 {
  background:
    radial-gradient(circle at 74% 20%, rgba(205, 224, 232, 0.24), transparent 22%),
    radial-gradient(circle at 22% 78%, rgba(197, 180, 154, 0.14), transparent 26%),
    linear-gradient(180deg, #a4b6c6 0%, #b4b1a8 54%, #91b3bc 100%);
}

.topic-card__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(32rpx);
  animation: drift 8s ease-in-out infinite;
  transition: transform 220ms ease, opacity 220ms ease;
}

.topic-card__mist--a {
  top: -30rpx;
  right: 30rpx;
  width: 280rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.18);
}

.topic-card__mist--b {
  left: 40rpx;
  bottom: 30rpx;
  width: 300rpx;
  height: 200rpx;
  background: rgba(255, 195, 157, 0.24);
  animation-delay: -2.2s;
}

.topic-card__header,
.topic-card__body,
.topic-card__footer {
  position: relative;
  z-index: 2;
  transition: transform 220ms ease, opacity 220ms ease;
}

.topic-card--pressed .topic-card__mist--a {
  transform: translate3d(-10rpx, 8rpx, 0) scale(0.96);
  opacity: 0.8;
}

.topic-card--pressed .topic-card__mist--b {
  transform: translate3d(12rpx, -6rpx, 0) scale(0.98);
  opacity: 0.82;
}

.topic-card--pressed .topic-card__header {
  transform: translateY(2rpx);
}

.topic-card--pressed .topic-card__body {
  transform: translateY(5rpx);
}

.topic-card--pressed .topic-card__footer {
  transform: translateY(7rpx);
}

.topic-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topic-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.topic-card__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.topic-card__dot--live {
  background: #ffffff;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8);
}

.topic-card__dot--upcoming {
  background: rgba(255, 255, 255, 0.45);
}

.topic-card__status-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.topic-card__seat {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.topic-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.topic-card__title {
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1.08;
  letter-spacing: -1.5rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.topic-card__meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.topic-card__initiator {
  color: rgba(255, 255, 255, 0.95);
  font-size: 26rpx;
  font-weight: 600;
}

.topic-card__meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.topic-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.topic-card__pill {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.topic-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.topic-card__rules {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.topic-join-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.98), rgba(243, 238, 224, 0.94) 68%, rgba(220, 212, 191, 0.9));
  color: #111111;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow:
    0 10rpx 22rpx rgba(0, 0, 0, 0.12),
    0 0 26rpx rgba(255, 247, 220, 0.18);
  transform: translateY(0) scale(1);
  transition: transform 160ms ease, box-shadow 180ms ease, filter 180ms ease;
}

.topic-join-btn--pressed {
  transform: translateY(4rpx) scale(0.97);
  box-shadow:
    0 6rpx 14rpx rgba(0, 0, 0, 0.12),
    0 0 18rpx rgba(255, 247, 220, 0.12);
  filter: brightness(0.98) saturate(1.04);
}

/* ── 空间列表 ── */
