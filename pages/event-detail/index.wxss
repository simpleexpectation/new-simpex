.event-hero {
  margin-top: 20rpx;
  padding: 34rpx 28rpx;
  border-radius: 42rpx;
}

.event-hero__eyebrow {
  display: inline-flex;
  margin-bottom: 20rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.event-hero__meta {
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.detail-section {
  margin-top: 40rpx;
}

.detail-section__title {
  display: block;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.detail-section__copy {
  display: block;
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.mini-panel {
  border-radius: 30rpx;
  padding: 24rpx;
}

.mini-panel__label {
  display: block;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.mini-panel__value {
  display: block;
  margin-top: 18rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 44rpx;
}

/* ── 预约弹窗 ── */
.rsvp-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  animation: rsvpFadeIn 0.22s ease;
}

.rsvp-sheet {
  width: 100%;
  background: var(--panel);
  border-top: 1rpx solid var(--line);
  border-radius: 48rpx 48rpx 0 0;
  padding: 20rpx 32rpx 56rpx;
  animation: rsvpSlideUp 0.32s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 拖拽手柄，和 iOS sheet 语言一致 */
.rsvp-sheet__handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--line);
  margin: 0 auto 36rpx;
}

/* eyebrow 和其他页面保持一致：var(--text-tertiary) + 22rpx */
.rsvp-sheet__eyebrow {
  display: block;
  color: var(--text-tertiary);
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

/* 活动标题沿用 section-title 的字号/字重 */
.rsvp-sheet__event {
  display: block;
  color: var(--text-primary);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -1rpx;
  margin-bottom: 40rpx;
}

/* ── 风险警告块 ── */
.rsvp-warning {
  display: flex;
  gap: 18rpx;
  background: rgba(215, 166, 161, 0.07);
  border: 1rpx solid rgba(215, 166, 161, 0.18);
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 40rpx;
}

.rsvp-warning__bar {
  flex-shrink: 0;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--danger);
}

.rsvp-warning__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rsvp-warning__headline {
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 600;
}

.rsvp-warning__copy {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

/* ── 操作按钮行 ── */
.rsvp-sheet__actions {
  display: flex;
  gap: 18rpx;
}

.rsvp-sheet__actions .cta-button {
  flex: 1;
}

@keyframes rsvpFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes rsvpSlideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
