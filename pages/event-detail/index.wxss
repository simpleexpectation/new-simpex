/* page-shell 底部留出 footer 空间 */
.event-detail-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ── 渐变 Hero ── */
.detail-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -32rpx;
  padding: 0 32rpx 40rpx;
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.detail-hero--0 {
  background: linear-gradient(180deg, #738087, #c8beb7 76%, #c19a76 100%);
}

.detail-hero--1 {
  background: linear-gradient(180deg, #dedcef, #efe9e2 72%, #ff8a00 100%);
}

.detail-hero--2 {
  background: linear-gradient(180deg, #3f7657, #4f8c69 56%, #8ee6a0 100%);
}

.detail-hero--3 {
  background:
    radial-gradient(circle at 54% 34%, rgba(242,151,229,0.55), transparent 22%),
    linear-gradient(180deg, #c4b0de, #beb4e8 52%, #b7d0e8);
}

.detail-hero--4 {
  background: linear-gradient(180deg, #dedcef, #efe9e2 72%, #ff8a00 100%);
}

.detail-hero__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  animation: drift 8s ease-in-out infinite;
  pointer-events: none;
}

.detail-hero__mist--a {
  top: -40rpx;
  right: 20rpx;
  width: 320rpx;
  height: 260rpx;
  background: rgba(255, 255, 255, 0.2);
}

.detail-hero__mist--b {
  left: 20rpx;
  bottom: 20rpx;
  width: 300rpx;
  height: 200rpx;
  background: rgba(255, 195, 157, 0.22);
  animation-delay: -2.5s;
}

.detail-hero__back {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 500;
  align-self: flex-start;
}

.detail-hero__body {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 40rpx;
}

.detail-hero__pill {
  background: rgba(255, 255, 255, 0.22);
  color: rgba(255, 255, 255, 0.92);
  align-self: flex-start;
}

.detail-hero__title {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -1.5rpx;
  color: #ffffff;
}

.detail-hero__desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
}

/* ── 元信息列表 ── */
.meta-list {
  margin-top: 36rpx;
  border-radius: 28rpx;
  background: #111214;
  overflow: hidden;
}

.meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-row__label {
  font-size: 22rpx;
  color: rgba(243, 241, 231, 0.45);
  flex-shrink: 0;
  width: 100rpx;
}

.meta-row__value {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.9);
  text-align: right;
  flex: 1;
}

/* ── 内容区块 ── */
.detail-block {
  margin-top: 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #111214;
}

.detail-block__title {
  display: block;
  font-size: 22rpx;
  color: rgba(243, 241, 231, 0.45);
  letter-spacing: 0.5rpx;
  margin-bottom: 14rpx;
}

.detail-block__copy {
  display: block;
  font-size: 27rpx;
  color: rgba(243, 241, 231, 0.88);
  line-height: 1.7;
}

/* ── 信息卡片网格 ── */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.info-card {
  border-radius: 28rpx;
  padding: 26rpx 22rpx;
  background: #111214;
}

.info-card__label {
  display: block;
  font-size: 22rpx;
  color: rgba(243, 241, 231, 0.45);
  margin-bottom: 14rpx;
}

.info-card__value {
  display: block;
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.9);
  line-height: 1.5;
}

/* ── 固定底部操作栏 ── */
.detail-footer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 20;
}

.detail-footer__rail {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 14rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(96, 59, 20, 0.18), rgba(0, 0, 0, 0)),
    #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 -4rpx 40rpx rgba(0, 0, 0, 0.5);
}

.detail-footer__back {
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(243, 241, 231, 0.7);
  font-size: 26rpx;
  flex-shrink: 0;
}

.detail-footer__cta {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1eddd, #d8cfb5);
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-footer__ghost {
  padding: 0 22rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.7);
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ── 预约弹窗（保持原样） ── */
.rsvp-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  animation: rsvpFadeIn 0.22s ease;
}

.rsvp-sheet {
  width: 100%;
  background: var(--panel);
  border-top: 1rpx solid var(--line);
  border-radius: 48rpx 48rpx 0 0;
  padding: 20rpx 32rpx 56rpx;
  animation: rsvpSlideUp 0.32s cubic-bezier(0.4, 0, 0.2, 1);
}

.rsvp-sheet__handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--line);
  margin: 0 auto 36rpx;
}

.rsvp-sheet__eyebrow {
  display: block;
  color: var(--text-tertiary);
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.rsvp-sheet__event {
  display: block;
  color: var(--text-primary);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -1rpx;
  margin-bottom: 40rpx;
}

.rsvp-warning {
  display: flex;
  gap: 18rpx;
  background: rgba(215, 166, 161, 0.07);
  border: 1rpx solid rgba(215, 166, 161, 0.18);
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 40rpx;
}

.rsvp-warning__bar {
  flex-shrink: 0;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--danger);
}

.rsvp-warning__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rsvp-warning__headline {
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 600;
}

.rsvp-warning__copy {
  color: rgba(243, 241, 231, 0.82);
  font-size: 24rpx;
  line-height: 1.7;
}

.rsvp-sheet__actions {
  display: flex;
  gap: 18rpx;
}

.rsvp-sheet__actions .cta-button {
  flex: 1;
}

@keyframes rsvpFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes rsvpSlideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
