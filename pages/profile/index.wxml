<view class="page-shell profile-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">
  <nav-shell eyebrow="Simpex" title="我的" />

  <view class="profile-hero">
    <view class="profile-avatar">
      <text class="profile-avatar__initial">{{user.initial}}</text>
    </view>
    <text class="profile-name">{{user.name}}</text>
    <view class="profile-bio-lines">
      <text class="profile-bio-line">◈  {{user.bio}}</text>
      <text class="profile-bio-line">⌖  {{user.location}}</text>
    </view>
    <view class="profile-tags">
      <view wx:for="{{user.tags}}" wx:key="index" class="pill">{{item}}</view>
    </view>
  </view>

  <view class="moments-head">
    <text class="moments-head__title">我的事件</text>
    <text class="moments-head__action">不是回顾参加过什么，而是最近哪些真实发生正在慢慢代表你</text>
  </view>

  <view class="event-stage">
    <view
      wx:if="{{featuredMyEvent}}"
      class="event-stage__hero moment-art--{{featuredMyEvent.art}}"
      data-id="{{featuredMyEvent.id}}"
      bindtap="openMyEvent"
    >
      <view class="event-stage__hero-mist event-stage__hero-mist--a"></view>
      <view class="event-stage__hero-mist event-stage__hero-mist--b"></view>
      <view class="event-stage__hero-body">
        <view class="event-stage__hero-top">
          <text class="event-stage__hero-eyebrow">{{featuredMyEvent.previewEyebrow || featuredMyEvent.kindLabel}}</text>
          <text class="event-stage__hero-stamp">{{featuredMyEvent.graphTag}}</text>
        </view>
        <view class="event-stage__hero-card">
          <text class="event-stage__hero-title">{{featuredMyEvent.previewTitle}}</text>
          <text class="event-stage__hero-copy">{{featuredMyEvent.previewText}}</text>
          <view class="event-stage__hero-foot">
            <text class="event-stage__hero-chip">{{featuredMyEvent.anchor}}</text>
            <text class="event-stage__hero-note">{{featuredMyEvent.footnote}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="event-slice-list">
      <view
        wx:for="{{eventDeck}}"
        wx:key="id"
        class="event-slice event-slice--{{item.previewMode}} event-slice--{{item.layout}} moment-art--{{item.art}}"
        data-id="{{item.id}}"
        bindtap="openMyEvent"
      >
        <view class="event-slice__overlay {{item.previewMode === 'text' ? 'event-slice__overlay--text' : ''}}">
          <view class="event-slice__top">
            <text class="event-slice__eyebrow">{{item.previewEyebrow || item.kindLabel}}</text>
            <text class="event-slice__stamp">{{item.graphTag}}</text>
          </view>
          <view class="event-slice__body">
            <text wx:if="{{item.previewMode === 'text'}}" class="event-slice__quote">“</text>
            <text class="event-slice__title">{{item.previewTitle}}</text>
            <text class="event-slice__copy">{{item.previewText}}</text>
          </view>
          <view class="event-slice__foot">
            <text class="event-slice__chip">{{item.anchor}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="benefits-hub">
    <view class="benefits-hub__head">
      <view>
        <text class="benefits-hub__eyebrow">{{benefitsHub.eyebrow}}</text>
        <text class="benefits-hub__title">{{benefitsHub.title}}</text>
      </view>
    </view>
    <view class="benefits-hub__options">
      <view class="benefit-option" bindtap="openMembership">
        <view class="benefit-option__meta">
          <text class="benefit-option__badge">{{membership.badge}}</text>
          <text class="benefit-option__title">{{membership.plan}}</text>
          <text class="benefit-option__detail">有效期至 {{membership.renewal}}</text>
        </view>
        <text class="benefit-option__action">查看权益 ›</text>
      </view>
      <view class="benefit-option benefit-option--invite" bindtap="openInviteCenter">
        <view class="benefit-option__meta">
          <text class="benefit-option__badge">{{inviteSummary.badge}}</text>
          <text class="benefit-option__title">{{inviteSummary.title}}</text>
          <text class="benefit-option__detail">{{inviteSummary.detail}}</text>
        </view>
        <text class="benefit-option__action">邀请好友 ›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showEventModal && selectedEvent}}" class="event-modal-mask" bindtap="closeEventModal">
    <view class="event-modal" catchtap="">
      <view class="event-modal__handle"></view>
      <view
        class="event-modal__hero event-modal__hero--{{selectedEvent.previewMode}}"
        style="{{selectedEvent.previewMode === 'image' && selectedEvent.photoUrl ? 'background-image: linear-gradient(180deg, rgba(0,0,0,0.12), rgba(0,0,0,0.48)), url(' + selectedEvent.photoUrl + '); background-size: cover; background-position: center;' : ''}}"
      >
        <view class="event-modal__hero-card {{selectedEvent.previewMode === 'text' ? 'event-modal__hero-card--text' : ''}}">
          <text class="event-modal__eyebrow">{{selectedEvent.kindLabel}} · {{selectedEvent.graphTag}}</text>
          <text class="event-modal__title">{{selectedEvent.previewTitle}}</text>
          <text class="event-modal__meta">{{selectedEvent.previewText}}</text>
        </view>
      </view>
      <view class="event-modal__section">
        <text class="event-modal__section-label">这条切片正在代表你什么</text>
        <text class="event-modal__section-copy">{{selectedEvent.identityLens}}</text>
      </view>
      <view class="event-modal__section">
        <text class="event-modal__section-label">它连接到的内在问题</text>
        <text class="event-modal__section-copy">{{selectedEvent.innerQuestion}}</text>
      </view>
      <view class="event-modal__chips">
        <text wx:for="{{selectedEvent.chips}}" wx:key="index" class="event-modal__chip">{{item}}</text>
      </view>
      <view class="event-modal__actions">
        <view class="event-modal__button event-modal__button--primary" bindtap="pinEventToProfile">挂到名片</view>
        <view class="event-modal__button" bindtap="useEventAsStarter">带去发起对话</view>
        <view class="event-modal__button" bindtap="closeEventModal">先留在这里</view>
      </view>
    </view>
  </view>
</view>
