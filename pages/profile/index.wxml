<view class="page-shell profile-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">
  <nav-shell eyebrow="Simpex" title="我的" />

  <view class="profile-hero">
    <view class="profile-avatar">
      <text class="profile-avatar__initial">{{user.initial}}</text>
    </view>
    <text class="profile-name">{{user.name}}</text>
    <view class="profile-bio-lines">
      <text class="profile-bio-line">◈  {{user.bio}}</text>
      <text class="profile-bio-line">⌖  {{user.location}}</text>
    </view>
    <view class="profile-tags">
      <view wx:for="{{user.tags}}" wx:key="index" class="pill">{{item}}</view>
    </view>
  </view>

  <view class="event-head">
    <view>
      <text class="event-head__eyebrow">MY EVENTS</text>
      <text class="event-head__title">我的事件</text>
      <text class="event-head__copy">最近哪些真实发生，正在慢慢代表你</text>
    </view>
    <text class="event-head__count">{{eventSlides.length}} 张</text>
  </view>

  <swiper class="event-swiper" current="{{eventCurrent}}" previous-margin="36rpx" next-margin="132rpx" circular bindchange="onEventSwiperChange">
    <swiper-item wx:for="{{eventSlides}}" wx:key="id">
      <view class="event-slide">
        <view class="event-card event-card--{{item.heroTone}} {{pressedEventId === item.id ? 'event-card--pressed' : ''}}" data-id="{{item.id}}" bindtouchstart="pressEventCard" bindtouchend="releaseEventCard" bindtouchcancel="releaseEventCard" bindtap="openMyEvent">
          <view class="event-card__mist"></view>
          <view class="event-card__body">
            <view class="event-card__topline">
              <text class="event-card__tag">{{item.previewEyebrow || item.kindLabel}}</text>
              <text class="event-card__date">{{item.relativeTime}}</text>
            </view>
            <view class="event-card__bottom">
              <text class="event-card__title">{{item.previewTitle}}</text>
              <view class="event-card__footer">
                <view class="event-card__footer-meta">
                  <text class="event-card__foot">{{item.graphTag}}</text>
                  <text class="event-card__foot">{{item.venueShort}}</text>
                </view>
                <text class="event-card__index">{{item.indexLabel}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="event-dots">
    <view wx:for="{{eventSlides}}" wx:key="id" class="event-dot {{index === eventCurrent ? 'event-dot--active' : ''}}"></view>
  </view>

  <view class="entry-grid">
    <view class="entry-card entry-card--unlock {{pressedEntry === 'unlock' ? 'entry-card--pressed' : ''}}" data-entry="unlock" bindtouchstart="pressEntryCard" bindtouchend="releaseEntryCard" bindtouchcancel="releaseEntryCard" bindtap="openInviteUnlock">
      <view class="entry-card__content">
        <text class="entry-card__eyebrow">{{unlockEntry.badge}}</text>
        <text class="entry-card__title">{{unlockEntry.title}}</text>
        <text class="entry-card__copy">{{unlockEntry.detail}}</text>
        <view class="entry-card__button">{{unlockEntry.cta}}</view>
      </view>
    </view>

    <view class="entry-card entry-card--cobuild {{pressedEntry === 'cobuild' ? 'entry-card--pressed' : ''}}" data-entry="cobuild" bindtouchstart="pressEntryCard" bindtouchend="releaseEntryCard" bindtouchcancel="releaseEntryCard" bindtap="openCoBuildPlan">
      <view class="entry-card__content">
        <text class="entry-card__eyebrow">{{coBuildEntry.badge}}</text>
        <text class="entry-card__title">{{coBuildEntry.title}}</text>
        <text class="entry-card__copy">{{coBuildEntry.detail}}</text>
        <view class="entry-card__button">{{coBuildEntry.cta}}</view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showEventModal}}" class="event-modal-mask" bindtap="closeEventModal">
  <view class="event-modal-sheet" catchtap="">
    <view class="event-modal-sheet__handle"></view>

    <view class="event-modal-card event-card--{{selectedEvent.heroTone}}">
      <view class="event-card__mist"></view>
      <view class="event-modal-card__body">
        <view class="event-card__topline">
          <text class="event-card__tag">{{selectedEvent.previewEyebrow || selectedEvent.kindLabel}}</text>
          <text class="event-card__date">{{selectedEvent.relativeTime}}</text>
        </view>
        <view class="event-modal-card__center">
          <text class="event-modal-card__title">{{selectedEvent.previewTitle}}</text>
          <text class="event-modal-card__text">{{selectedEvent.previewText}}</text>
        </view>
        <view class="event-card__footer">
          <view class="event-card__footer-meta">
            <text class="event-card__foot">{{selectedEvent.graphTag}}</text>
            <text class="event-card__foot">{{selectedEvent.venueShort}}</text>
          </view>
          <text class="event-card__index">{{selectedEvent.indexLabel}}</text>
        </view>
      </view>
    </view>

    <view class="event-modal-copy">
      <text class="event-modal-copy__eyebrow">它正在代表的你</text>
      <text class="event-modal-copy__text">{{selectedEvent.identityLens}}</text>
    </view>

    <view class="event-modal-meta">
      <text class="event-modal-meta__item">{{selectedEvent.summary}}</text>
      <text class="event-modal-meta__item">{{selectedEvent.footnote}}</text>
    </view>

    <view class="event-modal-actions">
      <view class="event-modal-actions__row">
        <view class="event-modal-btn event-modal-btn--primary {{pressedModalAction === 'pin' ? 'event-modal-btn--pressed' : ''}}" data-action="pin" bindtouchstart="pressModalAction" bindtouchend="releaseModalAction" bindtouchcancel="releaseModalAction" bindtap="pinEventToCard">挂到名片</view>
        <view class="event-modal-btn event-modal-btn--ghost {{pressedModalAction === 'prompt' ? 'event-modal-btn--pressed' : ''}}" data-action="prompt" bindtouchstart="pressModalAction" bindtouchend="releaseModalAction" bindtouchcancel="releaseModalAction" bindtap="useEventAsPrompt">作为发起入口</view>
      </view>
      <view class="event-modal-btn event-modal-btn--text {{pressedModalAction === 'close' ? 'event-modal-btn--pressed' : ''}}" data-action="close" bindtouchstart="pressModalAction" bindtouchend="releaseModalAction" bindtouchcancel="releaseModalAction" bindtap="closeEventModal">继续保留</view>
    </view>
  </view>
</view>
