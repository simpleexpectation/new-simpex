<view class="page-shell profile-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">

  <nav-shell eyebrow="Simpex" title="我的" />

  <!-- ── 头像 ── -->
  <view class="profile-avatar">
    <text class="profile-avatar__initial">{{user.initial}}</text>
  </view>

  <!-- ── 名字 ── -->
  <text class="profile-name">{{user.name}}</text>

  <!-- ── 简介行 ── -->
  <view class="profile-bio-lines">
    <text class="profile-bio-line">◈  {{user.bio}}</text>
    <text class="profile-bio-line">⌖  {{user.location}}</text>
  </view>

  <!-- ── 标签 ── -->
  <view class="profile-tags">
    <view wx:for="{{user.tags}}" wx:key="index" class="pill">{{item}}</view>
  </view>

  <!-- ── 我的事件 ── -->
  <view class="moments-head">
    <text class="moments-head__title">我的事件</text>
    <text class="moments-head__action">点开查看 ›</text>
  </view>

  <view class="moments-grid">
    <view
      wx:for="{{myEvents}}"
      wx:key="id"
      class="moment-card moment-card--{{item.layout}} moment-card--{{item.previewMode}} moment-art--{{item.art}}"
      style="{{item.previewMode === 'image' && item.photoUrl ? 'background-image: linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.42)), url(' + item.photoUrl + '); background-size: cover; background-position: center;' : ''}}"
      data-id="{{item.id}}"
      bindtap="openMyEvent"
    >
      <view wx:if="{{item.previewMode === 'image'}}" class="moment-card__overlay">
        <view class="moment-card__module">
          <text class="moment-card__eyebrow">{{item.previewEyebrow}}</text>
          <text class="moment-card__title">{{item.previewTitle}}</text>
        </view>
        <text class="moment-card__tag">{{item.previewText}}</text>
      </view>
      <view wx:else class="moment-card__paper">
        <text class="moment-card__eyebrow moment-card__eyebrow--dark">{{item.previewEyebrow}}</text>
        <text class="moment-card__title moment-card__title--dark">{{item.previewTitle}}</text>
        <text class="moment-card__copy">{{item.previewText}}</text>
      </view>
    </view>
  </view>

  <view class="invite-entry" bindtap="openInviteCenter">
    <view>
      <text class="invite-entry__title">{{inviteSummary.title}}</text>
      <text class="invite-entry__detail">{{inviteSummary.detail}}</text>
      <text class="invite-entry__subdetail">{{inviteSummary.subdetail}}</text>
    </view>
    <text class="invite-entry__action">查看规则 ›</text>
  </view>

  <!-- ── 会员入口 ── -->
  <view class="membership-entry" bindtap="openMembership">
    <text class="membership-entry__plan">{{membership.plan}}</text>
    <text class="membership-entry__sub">有效期至 {{membership.renewal}} · 点击查看权益</text>
  </view>

</view>
