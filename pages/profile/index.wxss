.profile-page {
  position: relative;
}

.profile-hero {
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  padding: 10rpx 4rpx 6rpx;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #6f787f, #beb6b0 56%, #b98f69);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.profile-avatar__initial {
  font-size: 58rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
}

.profile-name {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  line-height: 0.92;
  letter-spacing: -3rpx;
  color: #f3f1e7;
  margin-bottom: 18rpx;
}

.profile-bio-lines {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.profile-bio-line {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.78);
  line-height: 1.5;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-tags .pill {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.88);
}

.moments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.moments-head__title {
  font-size: 28rpx;
  color: rgba(243, 241, 231, 0.84);
  font-weight: 600;
}

.moments-head__action {
  font-size: 24rpx;
  color: rgba(243, 241, 231, 0.48);
  max-width: 420rpx;
  text-align: right;
  line-height: 1.4;
}

.event-stage {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.event-stage__hero,
.event-slice {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  box-shadow:
    0 24rpx 56rpx rgba(0, 0, 0, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.event-stage__hero {
  min-height: 420rpx;
  padding: 20rpx;
}

.event-stage__hero-mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(34rpx);
  pointer-events: none;
}

.event-stage__hero-mist--a {
  top: 18rpx;
  right: 24rpx;
  width: 220rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.12);
}

.event-stage__hero-mist--b {
  left: 24rpx;
  bottom: 30rpx;
  width: 300rpx;
  height: 180rpx;
  background: rgba(255, 222, 193, 0.12);
}

.event-stage__hero-body {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.event-stage__hero-top,
.event-slice__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.event-stage__hero-eyebrow,
.event-slice__eyebrow {
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: rgba(255, 255, 255, 0.72);
}

.event-stage__hero-stamp,
.event-slice__stamp {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.78);
  font-size: 18rpx;
}

.moment-art--dusk {
  background:
    radial-gradient(circle at 78% 18%, rgba(235, 222, 152, 0.3), transparent 22%),
    radial-gradient(circle at 18% 76%, rgba(117, 138, 151, 0.16), transparent 28%),
    linear-gradient(180deg, #5d6671 0%, #7f746f 54%, #c09b79 100%);
}

.moment-art--forest {
  background:
    radial-gradient(circle at 76% 18%, rgba(230, 219, 158, 0.24), transparent 22%),
    radial-gradient(circle at 22% 80%, rgba(110, 156, 135, 0.18), transparent 28%),
    linear-gradient(180deg, #395b53 0%, #466b5f 50%, #8da084 100%);
}

.moment-art--paper {
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 248, 228, 0.86), transparent 22%),
    linear-gradient(180deg, #f7f1ea, #ece2d6 72%, #e2d5c8);
}

.moment-art--mist {
  background:
    radial-gradient(circle at 20% 18%, rgba(255, 248, 240, 0.42), transparent 24%),
    linear-gradient(180deg, #ebe2d8, #d8cdc2);
}

.moment-art--warm {
  background:
    radial-gradient(circle at 76% 18%, rgba(243, 223, 150, 0.26), transparent 22%),
    radial-gradient(circle at 18% 76%, rgba(187, 144, 114, 0.16), transparent 28%),
    linear-gradient(180deg, #777f90 0%, #998879 56%, #c3a084 100%);
}

.event-stage__hero-card {
  max-width: 86%;
  border-radius: 26rpx;
  padding: 22rpx 20rpx 18rpx;
  background: linear-gradient(180deg, rgba(20, 18, 16, 0.12), rgba(20, 18, 16, 0.28));
  backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12),
    0 12rpx 30rpx rgba(0, 0, 0, 0.12);
}

.event-stage__hero-title {
  display: block;
  color: #ffffff;
  font-size: 46rpx;
  line-height: 1.14;
  font-weight: 600;
  letter-spacing: -1.2rpx;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.34);
}

.event-stage__hero-copy {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.6;
}

.event-stage__hero-foot,
.event-slice__foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.event-stage__hero-chip,
.event-slice__chip {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.82);
  font-size: 18rpx;
}

.event-stage__hero-note {
  color: rgba(255, 255, 255, 0.52);
  font-size: 18rpx;
}

.event-slice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.event-slice {
  min-height: 210rpx;
}

.event-slice--wide {
  min-height: 238rpx;
}

.event-slice__overlay {
  position: absolute;
  inset: 0;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(7, 7, 9, 0.04), rgba(7, 7, 9, 0.12));
}

.event-slice__overlay--text {
  background:
    radial-gradient(circle at 80% 18%, rgba(255, 247, 226, 0.74), transparent 24%),
    linear-gradient(180deg, rgba(252, 247, 241, 0.98), rgba(240, 232, 223, 0.94));
}

.event-slice__body {
  max-width: 78%;
  border-radius: 24rpx;
  padding: 20rpx 18rpx 18rpx;
  background: linear-gradient(180deg, rgba(24, 21, 18, 0.14), rgba(24, 21, 18, 0.32));
  backdrop-filter: blur(18rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.event-slice__overlay--text .event-slice__body {
  max-width: 84%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  border-color: rgba(25, 18, 17, 0.05);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.34),
    0 10rpx 26rpx rgba(129, 109, 86, 0.08);
}

.event-slice__quote {
  display: block;
  font-size: 54rpx;
  line-height: 0.8;
  color: rgba(25, 18, 17, 0.18);
  margin-bottom: 8rpx;
}

.event-slice__title {
  display: block;
  font-size: 36rpx;
  line-height: 1.18;
  font-weight: 600;
  letter-spacing: -0.8rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.32);
}

.event-slice__overlay--text .event-slice__title {
  color: #191211;
  text-shadow: none;
}

.event-slice__copy {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  line-height: 1.55;
}

.event-slice__overlay--text .event-slice__copy,
.event-slice__overlay--text .event-slice__eyebrow,
.event-slice__overlay--text .event-slice__stamp {
  color: rgba(25, 18, 17, 0.48);
}

.event-slice__overlay--text .event-slice__stamp,
.event-slice__overlay--text .event-slice__chip {
  background: rgba(25, 18, 17, 0.06);
  color: rgba(25, 18, 17, 0.54);
}

.benefits-hub {
  margin-top: 6rpx;
  margin-bottom: 10rpx;
}

.benefits-hub__head {
  display: block;
  margin-bottom: 14rpx;
}

.benefits-hub__eyebrow {
  display: block;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  letter-spacing: 2.4rpx;
  text-transform: uppercase;
  color: rgba(243, 241, 231, 0.36);
}

.benefits-hub__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(243, 241, 231, 0.82);
}

.benefits-hub__options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.benefit-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 232, 0.08), rgba(96, 70, 42, 0.12));
  border: 1rpx solid rgba(255, 236, 196, 0.08);
}

.benefit-option--invite {
  background:
    linear-gradient(135deg, rgba(222, 215, 196, 0.08), rgba(77, 63, 49, 0.12));
  border: 1rpx solid rgba(225, 214, 188, 0.08);
}

.benefit-option__badge {
  display: block;
  font-size: 18rpx;
  color: rgba(243, 241, 231, 0.34);
}

.benefit-option__title {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.86);
  font-weight: 600;
}

.benefit-option__detail {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(243, 241, 231, 0.46);
  line-height: 1.5;
}

.benefit-option__action {
  color: rgba(243, 241, 231, 0.56);
  font-size: 20rpx;
  white-space: nowrap;
}

.event-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.58);
  z-index: 220;
  display: flex;
  align-items: flex-end;
}

.event-modal {
  width: 100%;
  border-radius: 42rpx 42rpx 0 0;
  background: #101012;
  padding: 18rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
}

.event-modal__handle {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(243, 241, 231, 0.16);
  margin: 0 auto 22rpx;
}

.event-modal__hero {
  min-height: 280rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 228, 181, 0.16), transparent 24%),
    rgba(255, 255, 255, 0.04);
}

.event-modal__hero--text {
  background: linear-gradient(180deg, rgba(255, 251, 246, 0.96), rgba(241, 236, 230, 0.9));
}

.event-modal__hero-card {
  height: 100%;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.event-modal__hero-card--text .event-modal__eyebrow,
.event-modal__hero-card--text .event-modal__meta {
  color: rgba(25, 18, 17, 0.5);
}

.event-modal__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.48);
  font-size: 18rpx;
}

.event-modal__title {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 600;
}

.event-modal__hero-card--text .event-modal__title {
  color: #191211;
}

.event-modal__meta {
  display: block;
  color: rgba(243, 241, 231, 0.74);
  font-size: 24rpx;
  line-height: 1.55;
}

.event-modal__section {
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.event-modal__section-label {
  display: block;
  color: rgba(243, 241, 231, 0.44);
  font-size: 20rpx;
}

.event-modal__section-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(243, 241, 231, 0.88);
  font-size: 26rpx;
  line-height: 1.7;
}

.event-modal__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.event-modal__chip {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(243, 241, 231, 0.62);
  font-size: 18rpx;
}

.event-modal__actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.event-modal__button {
  min-height: 92rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.event-modal__button--primary {
  background: linear-gradient(135deg, #f1eddd, #d8cfb5);
  color: #111111;
  font-weight: 600;
}
