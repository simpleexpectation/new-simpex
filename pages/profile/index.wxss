.profile-page {
  position: relative;
}

/* ── 头像 ── */
.profile-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #738087, #c8beb7 55%, #c19a76);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  margin-bottom: 28rpx;
}

.profile-avatar__initial {
  font-size: 58rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
}

/* ── 名字 ── */
.profile-name {
  display: block;
  font-size: 86rpx;
  font-weight: 700;
  line-height: 0.92;
  letter-spacing: -3rpx;
  color: #f3f1e7;
  margin-bottom: 24rpx;
}

/* ── 简介行 ── */
.profile-bio-lines {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.profile-bio-line {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.78);
  line-height: 1.5;
}

/* ── 标签 ── */
.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 44rpx;
}

.profile-tags .pill {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.88);
}

/* ── 瞬间标题栏 ── */
.moments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.moments-head__title {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.68);
}

.moments-head__action {
  font-size: 24rpx;
  color: rgba(243, 241, 231, 0.48);
}

/* ── 事件照片网格 ── */
.moments-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.moment-card {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

.moment-card--tall {
  height: 320rpx;
}

.moment-card--wide {
  grid-column: span 2;
  height: 240rpx;
}

.moment-art--night {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.48) 100%),
    radial-gradient(circle at 50% 38%, rgba(111,237,161,0.18), transparent 22%),
    linear-gradient(180deg, #2f6e54, #3b7c5e 50%, #4d9970);
}

.moment-art--dusk {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.42) 100%),
    linear-gradient(180deg, #738087, #c8beb7 76%, #c19a76 100%);
}

.moment-art--forest {
  background:
    linear-gradient(180deg, transparent 35%, rgba(0,0,0,0.44) 100%),
    linear-gradient(180deg, #3f7657, #4f8c69 56%, #8ee6a0 100%);
}

.moment-art--sky {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.44) 100%),
    radial-gradient(circle at 54% 34%, rgba(242,151,229,0.55), transparent 22%),
    linear-gradient(180deg, #c4b0de, #beb4e8 52%, #b7d0e8);
}

.moment-art--warm {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.46) 100%),
    linear-gradient(180deg, #dedcef, #efe9e2 72%, #ff8a00 100%);
}

.moment-art--paper {
  background: linear-gradient(180deg, #f5efe8, #ece2d7);
}

.moment-art--mist {
  background: linear-gradient(180deg, #dad2c8, #cec4ba);
}

.moment-card__overlay,
.moment-card__paper {
  position: absolute;
  inset: 0;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.moment-card__paper {
  justify-content: flex-start;
  gap: 10rpx;
  background: rgba(255, 250, 246, 0.72);
  backdrop-filter: blur(20rpx);
}

.moment-card__module {
  align-self: flex-start;
  max-width: 78%;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 250, 246, 0.82);
  backdrop-filter: blur(20rpx);
}

.moment-card__eyebrow {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.66);
  margin-bottom: 6rpx;
}

.moment-card__eyebrow--dark {
  color: rgba(25, 18, 17, 0.46);
}

.moment-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
}

.moment-card__title--dark {
  color: #191211;
  text-shadow: none;
}

.moment-card__tag {
  align-self: flex-start;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 246, 0.78);
  color: #3a2520;
  font-size: 18rpx;
  display: inline-flex;
  align-items: center;
}

.moment-card__label {
  margin-top: auto;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.4;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.6);
}

.moment-card__copy {
  font-size: 22rpx;
  color: rgba(25, 18, 17, 0.72);
  line-height: 1.5;
}

.invite-entry {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 84% 22%, rgba(248, 229, 172, 0.18), transparent 22%),
    linear-gradient(145deg, rgba(49, 36, 22, 0.94), rgba(24, 17, 10, 0.98));
  border: 1rpx solid rgba(255, 228, 181, 0.12);
}

.invite-entry__title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff2d4;
}

.invite-entry__detail {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 242, 212, 0.76);
  font-size: 24rpx;
  line-height: 1.6;
}

.invite-entry__subdetail {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 242, 212, 0.52);
  font-size: 22rpx;
  line-height: 1.6;
}

.invite-entry__action {
  padding-top: 6rpx;
  color: #fff2d4;
  font-size: 22rpx;
  white-space: nowrap;
}

/* ── 会员入口（暗金黑卡风格）── */
.membership-entry {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #141108 0%, #1e1b0e 50%, #141108 100%);
  border: 1rpx solid rgba(223, 215, 176, 0.22);
}

/* 右上角光晕装饰 */
.membership-entry::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(223, 215, 176, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.membership-entry__plan {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #dfd7b0;
  margin-bottom: 10rpx;
}

.membership-entry__sub {
  display: block;
  color: rgba(223, 215, 176, 0.45);
  font-size: 24rpx;
}
