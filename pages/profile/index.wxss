.profile-page {
  position: relative;
}

/* ── 头像 ── */
.profile-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #738087, #c8beb7 55%, #c19a76);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  margin-bottom: 28rpx;
}

.profile-avatar__initial {
  font-size: 58rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
}

/* ── 名字 ── */
.profile-name {
  display: block;
  font-size: 86rpx;
  font-weight: 700;
  line-height: 0.92;
  letter-spacing: -3rpx;
  color: #f3f1e7;
  margin-bottom: 24rpx;
}

/* ── 简介行 ── */
.profile-bio-lines {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.profile-bio-line {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.78);
  line-height: 1.5;
}

/* ── 标签 ── */
.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.profile-tags .pill {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.88);
}

/* ── 统计行 ── */
.profile-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 48rpx;
}

.profile-stats__num {
  font-size: 28rpx;
  font-weight: 600;
  color: #f3f1e7;
}

.profile-stats__label {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.62);
}

.profile-stats__dot {
  font-size: 22rpx;
  color: rgba(243, 241, 231, 0.35);
  margin: 0 6rpx;
}

.profile-stats__line {
  flex: 1;
  height: 1rpx;
  background: var(--line);
  margin-left: 8rpx;
}

/* ── 瞬间标题栏 ── */
.moments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.moments-head__title {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.68);
}

.moments-head__action {
  font-size: 24rpx;
  color: rgba(243, 241, 231, 0.48);
}

/* ── 瞬间照片网格 ── */
.moments-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.moment-card {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
}

.moment-card--tall {
  height: 320rpx;
}

/* 横版全宽：占满两列 */
.moment-card--wide {
  grid-column: span 2;
  height: 240rpx;
}

/* 各张照片的渐变美术 —— 对齐 app 现有色系 */

/* 在场页风格：深森林绿 */
.moment-art--night {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.48) 100%),
    radial-gradient(circle at 50% 38%, rgba(111,237,161,0.18), transparent 22%),
    linear-gradient(180deg, #2f6e54, #3b7c5e 50%, #4d9970);
}

/* 活动卡片色系 0：石板灰 → 暖棕 */
.moment-art--dusk {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.42) 100%),
    linear-gradient(180deg, #738087, #c8beb7 76%, #c19a76 100%);
}

/* 活动卡片色系 2：森林绿 */
.moment-art--forest {
  background:
    linear-gradient(180deg, transparent 35%, rgba(0,0,0,0.44) 100%),
    linear-gradient(180deg, #3f7657, #4f8c69 56%, #8ee6a0 100%);
}

/* 空间页 poster 天空色：薰衣草紫 → 蓝 */
.moment-art--sky {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.44) 100%),
    radial-gradient(circle at 54% 34%, rgba(242,151,229,0.55), transparent 22%),
    linear-gradient(180deg, #c4b0de, #beb4e8 52%, #b7d0e8);
}

/* 活动卡片色系 1：薰衣草 → 橙 */
.moment-art--warm {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.46) 100%),
    linear-gradient(180deg, #dedcef, #efe9e2 72%, #ff8a00 100%);
}

/* 文字标签浮在照片上 */
.moment-card__label {
  position: absolute;
  bottom: 18rpx;
  left: 18rpx;
  right: 18rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.4;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.6);
}

/* ── 会员入口（暗金黑卡风格）── */
.membership-entry {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #141108 0%, #1e1b0e 50%, #141108 100%);
  border: 1rpx solid rgba(223, 215, 176, 0.22);
}

/* 右上角光晕装饰 */
.membership-entry::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(223, 215, 176, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.membership-entry__plan {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #dfd7b0;
  margin-bottom: 10rpx;
}

.membership-entry__sub {
  display: block;
  color: rgba(223, 215, 176, 0.45);
  font-size: 24rpx;
}
