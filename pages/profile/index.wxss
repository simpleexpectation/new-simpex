.profile-page {
  position: relative;
}

.profile-hero {
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  padding: 10rpx 4rpx 6rpx;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #6f787f, #beb6b0 56%, #b98f69);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.profile-avatar__initial {
  font-size: 58rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
}

.profile-name {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  line-height: 0.92;
  letter-spacing: -3rpx;
  color: #f3f1e7;
  margin-bottom: 18rpx;
}

.profile-bio-lines {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.profile-bio-line {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.78);
  line-height: 1.5;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-tags .pill {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.88);
}

.moments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.moments-head__title {
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.68);
}

.moments-head__action {
  font-size: 24rpx;
  color: rgba(243, 241, 231, 0.48);
}

.moments-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.moment-fragment {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

.moment-fragment--tall {
  height: 320rpx;
}

.moment-fragment--wide {
  grid-column: span 2;
  height: 240rpx;
}

.moment-art--dusk {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.42) 100%),
    linear-gradient(180deg, #738087, #c8beb7 76%, #c19a76 100%);
}

.moment-art--forest {
  background:
    linear-gradient(180deg, transparent 35%, rgba(0,0,0,0.44) 100%),
    linear-gradient(180deg, #3f7657, #4f8c69 56%, #8ee6a0 100%);
}

.moment-art--paper {
  background: linear-gradient(180deg, #f5efe8, #ece2d7);
}

.moment-art--mist {
  background: linear-gradient(180deg, #dad2c8, #cec4ba);
}

.moment-art--warm {
  background:
    linear-gradient(180deg, transparent 38%, rgba(0,0,0,0.46) 100%),
    linear-gradient(180deg, #dedcef, #efe9e2 72%, #ff8a00 100%);
}

.moment-fragment__body {
  position: absolute;
  inset: 0;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.moment-fragment__body--text {
  background: rgba(255, 250, 246, 0.76);
  backdrop-filter: blur(20rpx);
}

.moment-fragment__eyebrow {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.66);
}

.moment-fragment__body--text .moment-fragment__eyebrow,
.moment-fragment__body--text .moment-fragment__meta {
  color: rgba(25, 18, 17, 0.48);
}

.moment-fragment__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
}

.moment-fragment__body--text .moment-fragment__title {
  color: #191211;
  text-shadow: none;
}

.moment-fragment__meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  line-height: 1.45;
}

.benefits-hub {
  margin-top: 6rpx;
  margin-bottom: 10rpx;
}

.benefits-hub__head {
  display: block;
  margin-bottom: 14rpx;
}

.benefits-hub__eyebrow {
  display: block;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  letter-spacing: 2.4rpx;
  text-transform: uppercase;
  color: rgba(243, 241, 231, 0.36);
}

.benefits-hub__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(243, 241, 231, 0.82);
}

.benefits-hub__options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.benefit-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 232, 0.08), rgba(96, 70, 42, 0.12));
  border: 1rpx solid rgba(255, 236, 196, 0.08);
}

.benefit-option--invite {
  background:
    linear-gradient(135deg, rgba(222, 215, 196, 0.08), rgba(77, 63, 49, 0.12));
  border: 1rpx solid rgba(225, 214, 188, 0.08);
}

.benefit-option__badge {
  display: block;
  font-size: 18rpx;
  color: rgba(243, 241, 231, 0.34);
}

.benefit-option__title {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.86);
  font-weight: 600;
}

.benefit-option__detail {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(243, 241, 231, 0.46);
  line-height: 1.5;
}

.benefit-option__action {
  color: rgba(243, 241, 231, 0.56);
  font-size: 20rpx;
  white-space: nowrap;
}

.event-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.58);
  z-index: 220;
  display: flex;
  align-items: flex-end;
}

.event-modal {
  width: 100%;
  border-radius: 42rpx 42rpx 0 0;
  background: #101012;
  padding: 18rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
}

.event-modal__handle {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(243, 241, 231, 0.16);
  margin: 0 auto 22rpx;
}

.event-modal__hero {
  min-height: 280rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 228, 181, 0.16), transparent 24%),
    rgba(255, 255, 255, 0.04);
}

.event-modal__hero--text {
  background: linear-gradient(180deg, rgba(255, 251, 246, 0.96), rgba(241, 236, 230, 0.9));
}

.event-modal__hero-card {
  height: 100%;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.event-modal__hero-card--text .event-modal__eyebrow,
.event-modal__hero-card--text .event-modal__meta {
  color: rgba(25, 18, 17, 0.5);
}

.event-modal__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.48);
  font-size: 18rpx;
}

.event-modal__title {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 600;
}

.event-modal__hero-card--text .event-modal__title {
  color: #191211;
}

.event-modal__meta {
  display: block;
  color: rgba(243, 241, 231, 0.74);
  font-size: 24rpx;
  line-height: 1.55;
}

.event-modal__section {
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.event-modal__section-label {
  display: block;
  color: rgba(243, 241, 231, 0.44);
  font-size: 20rpx;
}

.event-modal__section-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(243, 241, 231, 0.88);
  font-size: 26rpx;
  line-height: 1.7;
}

.event-modal__actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.event-modal__button {
  min-height: 92rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.event-modal__button--primary {
  background: linear-gradient(135deg, #f1eddd, #d8cfb5);
  color: #111111;
  font-weight: 600;
}
