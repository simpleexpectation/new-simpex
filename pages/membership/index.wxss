.membership-topbar {
  display: flex;
  justify-content: flex-start;
  margin-top: 18rpx;
}

.membership-topbar__back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.78);
  font-size: 22rpx;
}

.membership-hero {
  margin-top: 24rpx;
  border-radius: 36rpx;
  padding: 28rpx;
  background: #f0efe3;
  color: #141414;
}

.membership-hero__plan {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
}

.membership-hero__renewal {
  display: block;
  margin-top: 12rpx;
  color: rgba(20, 20, 20, 0.6);
  font-size: 24rpx;
}

.membership-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.membership-item {
  border-radius: 26rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #f3f1e7;
  font-size: 26rpx;
}

.membership-footer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(-80rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.membership-footer__rail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 14rpx 14rpx;
  background:
    linear-gradient(180deg, rgba(96, 59, 20, 0.18), rgba(0, 0, 0, 0)),
    #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
}

.membership-footer__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  color: rgba(243, 241, 231, 0.46);
}

.membership-footer__item--active {
  color: #f3f1e7;
}

.membership-footer__text {
  font-size: 22rpx;
}
