.invite-page {
  position: relative;
  overflow: hidden;
}

.invite-page__glow {
  position: fixed;
  border-radius: 50%;
  filter: blur(96rpx);
  pointer-events: none;
  opacity: 0.58;
}

.invite-page__glow--a {
  top: 180rpx;
  right: -70rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(245, 213, 147, 0.18);
}

.invite-page__glow--b {
  left: -80rpx;
  top: 620rpx;
  width: 280rpx;
  height: 240rpx;
  background: rgba(157, 171, 205, 0.14);
}

.invite-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.invite-nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.invite-nav__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.invite-nav__title {
  color: #f3f1e7;
  font-size: 40rpx;
  font-weight: 600;
}

.invite-nav__sub {
  color: rgba(243, 241, 231, 0.48);
  font-size: 20rpx;
}

.quota-hero {
  margin-top: 34rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0 4rpx;
}

.quota-hero__label {
  color: rgba(243, 241, 231, 0.72);
  font-size: 26rpx;
}

.quota-hero__value {
  color: #fff1d3;
  font-size: 64rpx;
  line-height: 0.96;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.energy-panel {
  margin-top: 28rpx;
  border-radius: 38rpx;
  padding: 30rpx 28rpx;
  background:
    radial-gradient(circle at 84% 16%, rgba(245, 213, 147, 0.12), transparent 24%),
    linear-gradient(145deg, rgba(29, 23, 18, 0.96), rgba(12, 10, 8, 0.98));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.energy-panel__eyebrow {
  display: block;
  color: rgba(255, 228, 181, 0.44);
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
}

.energy-panel__title {
  display: block;
  margin-top: 12rpx;
  color: #fff2d4;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 600;
}

.energy-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.energy-cell {
  min-height: 176rpx;
  border-radius: 26rpx;
  padding: 20rpx 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.energy-cell--active {
  background:
    radial-gradient(circle at 50% 18%, rgba(245, 230, 160, 0.18), transparent 38%),
    rgba(255, 255, 255, 0.07);
  border-color: rgba(245, 230, 160, 0.22);
  box-shadow: 0 0 24rpx rgba(245, 230, 160, 0.08);
}

.energy-cell__status {
  color: rgba(255, 242, 212, 0.54);
  font-size: 20rpx;
}

.energy-cell__label {
  color: #fff2d4;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
}

.energy-panel__copy {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 242, 212, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
}

.invite-code-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.invite-code-card__label {
  display: block;
  color: rgba(243, 241, 231, 0.48);
  font-size: 20rpx;
}

.invite-code-card__code {
  display: block;
  margin-top: 10rpx;
  color: #fff2d4;
  font-size: 32rpx;
  letter-spacing: 1.4rpx;
  font-weight: 600;
}

.invite-code-card__action {
  min-width: 108rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.friend-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.friend-card {
  border-radius: 28rpx;
  padding: 24rpx 24rpx 22rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.friend-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.friend-card__name {
  display: block;
  color: #f3f1e7;
  font-size: 28rpx;
  font-weight: 600;
}

.friend-card__state {
  display: block;
  margin-top: 8rpx;
  color: rgba(243, 241, 231, 0.48);
  font-size: 22rpx;
}

.friend-card__button {
  min-width: 120rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fff2d4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.friend-card__note {
  display: block;
  margin-top: 16rpx;
  color: rgba(243, 241, 231, 0.68);
  font-size: 22rpx;
  line-height: 1.65;
}

.invite-actions {
  margin-top: 24rpx;
  padding-bottom: 32rpx;
}

.invite-actions__primary {
  min-height: 96rpx;
  border-radius: 28rpx;
  background: #f0efe3;
  color: #171412;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.invite-actions__hint {
  display: block;
  margin-top: 14rpx;
  color: rgba(243, 241, 231, 0.46);
  font-size: 20rpx;
  line-height: 1.7;
}
