<view class="page-shell invite-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">
  <view class="invite-page__glow invite-page__glow--a"></view>
  <view class="invite-page__glow invite-page__glow--b"></view>

  <nav-shell eyebrow="Invite to unlock">
    <view class="invite-nav">
      <view class="invite-nav__back" bindtap="goBack">‹</view>
      <view class="invite-nav__copy">
        <text class="invite-nav__title">邀请 2 位好友，0 元开启</text>
        <text class="invite-nav__sub">{{source === 'profile' ? '从我的页进入' : '从月卡购买页进入'}}</text>
      </view>
    </view>
  </nav-shell>

  <view class="quota-hero">
    <text class="quota-hero__label">限时免费名额仅剩</text>
    <text class="quota-hero__value">{{quota.remaining}}/{{quota.total}}</text>
  </view>

  <view class="energy-panel">
    <text class="energy-panel__eyebrow">Energy board</text>
    <text class="energy-panel__title">你已经点亮第一格，再邀请 2 位同频好友就够了</text>
    <view class="energy-grid">
      <view
        wx:for="{{slots}}"
        wx:key="key"
        class="energy-cell {{item.active ? 'energy-cell--active' : ''}}"
      >
        <text class="energy-cell__status">{{item.status}}</text>
        <text class="energy-cell__label">{{item.label}}</text>
      </view>
    </view>
    <text class="energy-panel__copy">真实发生，拒绝独行。还差 2 位同频大脑，解锁本月 60 场深度对话。</text>
  </view>

  <view class="invite-code-card">
    <view>
      <text class="invite-code-card__label">你的邀请码</text>
      <text class="invite-code-card__code">{{inviteCode}}</text>
    </view>
    <view class="invite-code-card__action" bindtap="copyInviteCode">复制</view>
  </view>

  <view class="friend-list">
    <view wx:for="{{invitedFriends}}" wx:key="name" class="friend-card">
      <view class="friend-card__head">
        <view>
          <text class="friend-card__name">{{item.name}}</text>
          <text class="friend-card__state">{{item.state}}</text>
        </view>
        <view class="friend-card__button" data-index="{{index}}" bindtap="inviteFriend">
          {{item.state === '尚未发送' ? '去邀请' : '再次发送'}}
        </view>
      </view>
      <text class="friend-card__note">{{item.note}}</text>
    </view>
  </view>

  <view class="invite-actions">
    <view class="invite-actions__primary" bindtap="inviteFriend" data-index="{{1}}">发送微信邀请</view>
    <text class="invite-actions__hint">对方完成注册后，对应能量格会自动点亮；点满 3 格后，本月月卡自动生效。</text>
  </view>
</view>
