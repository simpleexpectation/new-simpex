/* ── 页面容器 ── */
.blackhole-page {
  position: relative;
  overflow: hidden;
  height: 100vh;
  background: #000000;
  transition: opacity 220ms ease, transform 220ms ease;
}

/* ── 场域 ── */
.field {
  position: absolute;
  inset: 0;
  transition: opacity 0.5s ease;
}

.field--off {
  opacity: 0.08;
  pointer-events: none;
}

.field__glow {
  position: absolute;
  bottom: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(241, 237, 221, 0.05) 0%, transparent 70%);
  pointer-events: none;
}

/* ── 浮动气泡 ── */
.field__orb {
  position: absolute;
  transform: translate(-50%, -50%);
  animation: floatOrb 7s ease-in-out infinite;
  opacity: 0.82;
  transition: opacity 200ms ease;
}

.field__orb--selected {
  opacity: 1;
}

@keyframes floatOrb {
  0%, 100% { transform: translate(-50%, calc(-50% + 0px)); }
  50%       { transform: translate(-50%, calc(-50% - 22px)); }
}

/* ── 底部开关区 ── */
.switch-area {
  position: absolute;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.switch-wrap {
  padding: 20rpx;
}

/* 拨动开关 */
.switch {
  position: relative;
  width: 260rpx;
  height: 130rpx;
  border-radius: 999rpx;
  transition: background 0.35s ease;
}

.switch--on {
  background: linear-gradient(135deg, #f1eddd, #d4c9a8);
  box-shadow: 0 0 40rpx rgba(241, 237, 221, 0.15);
}

.switch--off {
  background: rgba(255, 255, 255, 0.07);
  box-shadow: none;
}

/* 圆形滑块 */
.switch__knob {
  position: absolute;
  top: 13rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1), background 0.35s ease;
}

.switch--on .switch__knob {
  left: calc(260rpx - 104rpx - 13rpx);
  background: #1a1814;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.5);
}

.switch--off .switch__knob {
  left: 13rpx;
  background: rgba(255, 255, 255, 0.22);
  box-shadow: none;
}

/* 文字 */
.switch-label {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  color: rgba(243, 241, 231, 0.85);
  transition: opacity 0.35s ease;
}

.switch-sub {
  font-size: 22rpx;
  color: rgba(243, 241, 231, 0.3);
  letter-spacing: 1rpx;
  min-height: 30rpx;
}

.switch-exit {
  margin-top: 8rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 24rpx;
  color: rgba(243, 241, 231, 0.4);
  letter-spacing: 1rpx;
}

/* ── 名片弹层 ── */
.orb-card {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.5);
  animation: cardFadeIn 0.2s ease;
}

.orb-card__sheet {
  width: 100%;
  background: #0d0d0d;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 48rpx 48rpx 0 0;
  padding: 20rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: cardSlideUp 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.orb-card__handle {
  width: 64rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 0 auto 40rpx;
}

.orb-card__info {
  margin-bottom: 40rpx;
}

.orb-card__name {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #f3f1e7;
  letter-spacing: -1rpx;
  margin-bottom: 12rpx;
}

.orb-card__role {
  display: block;
  font-size: 26rpx;
  color: rgba(243, 241, 231, 0.48);
  line-height: 1.5;
}

.orb-card__actions {
  display: flex;
  gap: 16rpx;
}

.orb-card__nudge {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(243, 241, 231, 0.72);
  font-size: 26rpx;
}

.orb-card__nudge-wave {
  font-size: 22rpx;
  opacity: 0.7;
}

.orb-card__view {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1eddd, #d8cfb5);
  color: #111111;
  font-size: 26rpx;
  font-weight: 600;
}

@keyframes cardFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes cardSlideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
