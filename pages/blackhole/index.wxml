<view class="blackhole-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">

  <!-- ── 场域气泡 ── -->
  <view class="field {{connected ? '' : 'field--off'}}">
    <view class="field__glow"></view>
    <view
      wx:for="{{bubbles}}"
      wx:key="id"
      class="field__orb {{selectedBubble.id === item.id ? 'field__orb--selected' : ''}}"
      style="left: {{item.x}}%; top: {{item.y}}%; animation-delay: {{item.floatDelay}}s;"
      data-id="{{item.id}}"
      bindtap="selectBubble"
      bindlongpress="nudgeBubble"
    >
      <glow-orb size="{{item.size}}" label="{{item.initial}}" hint="" />
    </view>
  </view>

  <!-- ── 底部开关区 ── -->
  <view class="switch-area">
    <view class="switch-wrap" bindtap="toggleConnect">
      <view class="switch {{connected ? 'switch--on' : 'switch--off'}}">
        <view class="switch__knob"></view>
      </view>
    </view>
    <text class="switch-label">{{connected ? '在场' : '已暂停'}}</text>
    <text class="switch-sub">{{connected ? bubbles.length + ' 人同在此刻' : '再次拨动即可重新加入'}}</text>
    <view wx:if="{{!connected}}" class="switch-exit" bindtap="endSession">退出活动</view>
  </view>

</view>

<!-- ── 名片弹层 ── -->
<view wx:if="{{showCard}}" class="orb-card" bindtap="closeCard">
  <view class="orb-card__sheet" catchtap="">
    <view class="orb-card__handle"></view>
    <view class="orb-card__info">
      <text class="orb-card__name">{{selectedBubble.name}}</text>
      <text class="orb-card__role">{{selectedBubble.role}}</text>
    </view>
    <view class="orb-card__actions">
      <view class="orb-card__nudge" bindtap="nudge">
        <text class="orb-card__nudge-wave">〰</text>
        <text>轻触共鸣</text>
      </view>
      <view class="orb-card__view" bindtap="viewCard">查看名片</view>
    </view>
  </view>
</view>
