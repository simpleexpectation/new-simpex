<view class="page-shell ai-entry-page {{pageReady ? 'page-ready' : ''}} {{pageLeaving ? 'page-leaving' : ''}}">
  <view class="ai-entry-page__glow ai-entry-page__glow--a"></view>
  <view class="ai-entry-page__glow ai-entry-page__glow--b"></view>

  <nav-shell eyebrow="AI onboarding">
    <view class="ai-entry-nav">
      <view class="ai-entry-nav__back" bindtap="goBack">‹</view>
      <view class="ai-entry-nav__copy">
        <text class="ai-entry-nav__title">先说一点最近的你</text>
        <text class="ai-entry-nav__sub">不需要先填手机号或资料，我们先一起做出第一张卡</text>
      </view>
    </view>
  </nav-shell>

  <view class="ai-entry-hero">
    <text class="ai-entry-hero__eyebrow">向内探索，向外发现</text>
    <text class="ai-entry-hero__title">用一次表达，代替传统注册</text>
    <text class="ai-entry-hero__copy">你可以回答 3 个轻问题，也可以直接说给我听。系统会帮你整理出一张值得发起的对话卡，并推荐更适合的人。</text>
  </view>

  <view class="ai-entry-mode">
    <view
      class="ai-entry-mode__item {{mode === 'questions' ? 'ai-entry-mode__item--active' : ''}}"
      data-mode="questions"
      bindtap="switchMode"
    >
      回答 3 个问题
    </view>
    <view
      class="ai-entry-mode__item {{mode === 'voice' ? 'ai-entry-mode__item--active' : ''}}"
      data-mode="voice"
      bindtap="switchMode"
    >
      直接说给我听
    </view>
  </view>

  <view wx:if="{{mode === 'questions'}}" class="ai-entry-question-list">
    <view wx:for="{{questionCards}}" wx:key="key" wx:for-item="question" class="ai-entry-question-card">
      <text class="ai-entry-question-card__eyebrow">{{question.eyebrow}}</text>
      <text class="ai-entry-question-card__title">{{question.title}}</text>
      <text class="ai-entry-question-card__hint">{{question.hint}}</text>
      <textarea
        class="ai-entry-question-card__textarea"
        value="{{question.value}}"
        data-key="{{question.key}}"
        bindinput="updateAnswer"
        auto-height
        maxlength="180"
        placeholder="{{question.placeholder}}"
        placeholder-class="ai-entry-question-card__placeholder"
      />
      <view class="ai-entry-question-card__chips">
        <view
          wx:for="{{question.suggestions}}"
          wx:key="index"
          wx:for-item="suggestion"
          class="ai-entry-question-card__chip"
          data-key="{{question.key}}"
          data-value="{{suggestion}}"
          bindtap="fillSuggestion"
        >
          {{suggestion}}
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{mode === 'voice'}}" class="ai-entry-voice-card">
    <view class="ai-entry-voice-card__head">
      <view>
        <text class="ai-entry-voice-card__title">直接说给我听</text>
        <text class="ai-entry-voice-card__sub">像发一段语音给一个理解你的人。你说得越自然，系统越容易帮你生成一张真的像你的卡。</text>
      </view>
      <view class="ai-entry-voice-card__orb">◉</view>
    </view>
    <textarea
      class="ai-entry-voice-card__textarea"
      value="{{voiceDraft}}"
      bindinput="updateVoiceDraft"
      auto-height
      maxlength="240"
      placeholder="比如：我最近总觉得自己在慢慢进入新的生活方式，也更想靠近能认真回应的人。"
      placeholder-class="ai-entry-question-card__placeholder"
    />
    <view class="ai-entry-voice-card__footer">
      <text class="ai-entry-voice-card__hint">后面可以接语音录入，这里先用转写后的文本展示。</text>
      <view class="ai-entry-voice-card__button" bindtap="generateCard">先帮我整理</view>
    </view>
  </view>

  <view wx:if="{{cardReady}}" class="ai-entry-result">
    <view class="ai-entry-result__mist ai-entry-result__mist--a"></view>
    <view class="ai-entry-result__mist ai-entry-result__mist--b"></view>
    <text class="ai-entry-result__eyebrow">{{generatedCard.eyebrow}}</text>
    <text class="ai-entry-result__title">{{generatedCard.title}}</text>
    <text class="ai-entry-result__summary">{{generatedCard.summary}}</text>

    <view class="ai-entry-result__block">
      <text class="ai-entry-result__label">为什么适合你现在发起</text>
      <text class="ai-entry-result__copy">{{generatedCard.launchReason}}</text>
    </view>

    <view class="ai-entry-result__block">
      <text class="ai-entry-result__label">系统会优先推荐给这些人</text>
      <view class="ai-entry-result__people">
        <text wx:for="{{generatedCard.people}}" wx:key="index" class="ai-entry-result__person">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="ai-entry-footer">
    <view class="ai-entry-footer__secondary" bindtap="continueOptimize">继续优化卡片</view>
    <view class="ai-entry-footer__primary" bindtap="subscribeLaunch">加入订阅并发起</view>
  </view>
</view>
