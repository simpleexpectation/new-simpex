.ai-entry-page {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 10%, rgba(245, 231, 141, 0.22), transparent 24%),
    radial-gradient(circle at 18% 18%, rgba(174, 202, 229, 0.18), transparent 24%),
    radial-gradient(circle at 20% 72%, rgba(236, 181, 136, 0.18), transparent 24%),
    linear-gradient(180deg, #1d1712 0%, #1a1418 42%, #17151d 100%);
}

.ai-entry-page__glow {
  position: fixed;
  border-radius: 50%;
  filter: blur(96rpx);
  pointer-events: none;
  opacity: 0.7;
}

.ai-entry-page__glow--a {
  width: 420rpx;
  height: 340rpx;
  top: 100rpx;
  right: -40rpx;
  background: rgba(243, 224, 144, 0.24);
}

.ai-entry-page__glow--b {
  width: 340rpx;
  height: 300rpx;
  left: -20rpx;
  top: 660rpx;
  background: rgba(166, 199, 228, 0.18);
}

.ai-entry-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.ai-entry-nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.ai-entry-nav__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-entry-nav__title {
  color: #f3f1e7;
  font-size: 40rpx;
  font-weight: 600;
}

.ai-entry-nav__sub {
  color: rgba(243, 241, 231, 0.5);
  font-size: 20rpx;
  line-height: 1.45;
}

.ai-entry-hero {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ai-entry-hero__eyebrow {
  color: rgba(243, 241, 231, 0.42);
  font-size: 18rpx;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}

.ai-entry-hero__title {
  color: #f3f1e7;
  font-size: 60rpx;
  line-height: 1.06;
  letter-spacing: -1.8rpx;
  font-weight: 600;
}

.ai-entry-hero__copy {
  color: rgba(243, 241, 231, 0.68);
  font-size: 24rpx;
  line-height: 1.65;
}

.ai-entry-composer {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 84% 14%, rgba(245, 230, 146, 0.24), transparent 22%),
    radial-gradient(circle at 18% 84%, rgba(228, 164, 120, 0.18), transparent 24%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.055));
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 30rpx 84rpx rgba(0, 0, 0, 0.24);
}

.ai-entry-composer__mist {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(18rpx);
}

.ai-entry-composer__mist--a {
  right: 18rpx;
  top: -20rpx;
  width: 220rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(246, 235, 184, 0.22), rgba(246, 235, 184, 0));
}

.ai-entry-composer__mist--b {
  left: -24rpx;
  bottom: -20rpx;
  width: 220rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(231, 170, 132, 0.18), rgba(231, 170, 132, 0));
}

.ai-entry-composer__head,
.ai-entry-composer__textarea,
.ai-entry-composer__chips {
  position: relative;
  z-index: 1;
}

.ai-entry-composer__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-entry-composer__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-entry-composer__title {
  color: #f3f1e7;
  font-size: 34rpx;
  font-weight: 600;
}

.ai-entry-composer__sub {
  color: rgba(243, 241, 231, 0.58);
  font-size: 21rpx;
  line-height: 1.6;
}

.ai-entry-composer__record {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(241, 225, 184, 0.3), rgba(235, 195, 128, 0.18));
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.ai-entry-composer__textarea {
  width: 100%;
  margin-top: 20rpx;
  min-height: 200rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 84% 16%, rgba(243, 229, 146, 0.08), transparent 18%),
    rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #f3f1e7;
  font-size: 28rpx;
  line-height: 1.72;
}

.ai-entry-composer__placeholder {
  color: rgba(243, 241, 231, 0.28);
}

.ai-entry-composer__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.ai-entry-composer__chip {
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(243, 241, 231, 0.78);
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
}

.ai-entry-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.ai-entry-actions__secondary,
.ai-entry-actions__primary {
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.ai-entry-actions__secondary {
  flex: 1;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  color: rgba(243, 241, 231, 0.86);
}

.ai-entry-actions__primary {
  flex: 1.15;
  background: linear-gradient(135deg, #f1e1b8, #edc680);
  color: #17130f;
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.16);
}

.ai-entry-processing {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 12, 11, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
  backdrop-filter: blur(8rpx);
}

.ai-entry-processing__panel {
  position: relative;
  overflow: hidden;
  width: 100%;
  padding: 34rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 82% 14%, rgba(245, 229, 143, 0.3), transparent 22%),
    radial-gradient(circle at 18% 84%, rgba(167, 198, 224, 0.16), transparent 24%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.28);
}

.ai-entry-processing__glow {
  position: absolute;
  right: 24rpx;
  top: -16rpx;
  width: 220rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(247, 235, 171, 0.24), rgba(247, 235, 171, 0));
  filter: blur(16rpx);
}

.ai-entry-processing__eyebrow,
.ai-entry-processing__title,
.ai-entry-processing__copy,
.ai-entry-processing__steps {
  position: relative;
  z-index: 1;
}

.ai-entry-processing__eyebrow {
  color: rgba(243, 241, 231, 0.46);
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
}

.ai-entry-processing__title {
  display: block;
  margin-top: 14rpx;
  color: #f3f1e7;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 600;
}

.ai-entry-processing__copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(243, 241, 231, 0.7);
  font-size: 22rpx;
  line-height: 1.65;
}

.ai-entry-processing__steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.ai-entry-processing__step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-entry-processing__step-label {
  width: 120rpx;
  color: rgba(243, 241, 231, 0.74);
  font-size: 20rpx;
}

.ai-entry-processing__step-bar {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(241, 225, 184, 0.96), rgba(237, 198, 128, 0.92));
  box-shadow: 0 0 14rpx rgba(241, 225, 184, 0.22);
}
