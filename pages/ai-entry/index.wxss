.ai-entry-page {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 10%, rgba(243, 229, 146, 0.1), transparent 22%),
    radial-gradient(circle at 18% 18%, rgba(156, 186, 212, 0.1), transparent 20%),
    radial-gradient(circle at 20% 72%, rgba(205, 165, 138, 0.08), transparent 22%),
    linear-gradient(180deg, #12100f 0%, #111012 34%, #101116 100%);
}

.ai-entry-page__glow {
  position: fixed;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
  opacity: 0.62;
}

.ai-entry-page__glow--a {
  width: 380rpx;
  height: 320rpx;
  top: 120rpx;
  right: -40rpx;
  background: rgba(243, 224, 144, 0.18);
}

.ai-entry-page__glow--b {
  width: 320rpx;
  height: 280rpx;
  left: -30rpx;
  top: 760rpx;
  background: rgba(156, 186, 212, 0.14);
}

.ai-entry-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.ai-entry-nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
}

.ai-entry-nav__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-entry-nav__title {
  color: #f3f1e7;
  font-size: 40rpx;
  font-weight: 600;
}

.ai-entry-nav__sub {
  color: rgba(243, 241, 231, 0.44);
  font-size: 20rpx;
  line-height: 1.45;
}

.ai-entry-hero {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ai-entry-hero__eyebrow {
  color: rgba(243, 241, 231, 0.42);
  font-size: 18rpx;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}

.ai-entry-hero__title {
  color: #f3f1e7;
  font-size: 60rpx;
  line-height: 1.06;
  letter-spacing: -1.8rpx;
  font-weight: 600;
}

.ai-entry-hero__copy {
  color: rgba(243, 241, 231, 0.62);
  font-size: 24rpx;
  line-height: 1.6;
}

.ai-entry-mode {
  margin-top: 26rpx;
  display: flex;
  gap: 12rpx;
}

.ai-entry-mode__item {
  flex: 1;
  min-height: 82rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.ai-entry-mode__item--active {
  background:
    radial-gradient(circle at 84% 18%, rgba(243, 229, 146, 0.14), transparent 22%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.04));
  border-color: rgba(243, 229, 146, 0.14);
  color: #f3f1e7;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.12);
}

.ai-entry-question-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ai-entry-question-card,
.ai-entry-voice-card {
  padding: 26rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 84% 14%, rgba(243, 229, 146, 0.1), transparent 20%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.032));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 18rpx 42rpx rgba(0, 0, 0, 0.1);
}

.ai-entry-question-card__eyebrow {
  display: block;
  color: rgba(243, 241, 231, 0.36);
  font-size: 18rpx;
  letter-spacing: 1.4rpx;
  text-transform: uppercase;
}

.ai-entry-question-card__title {
  display: block;
  margin-top: 12rpx;
  color: #f3f1e7;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 600;
}

.ai-entry-question-card__hint {
  display: block;
  margin-top: 10rpx;
  color: rgba(243, 241, 231, 0.5);
  font-size: 21rpx;
  line-height: 1.6;
}

.ai-entry-question-card__textarea,
.ai-entry-voice-card__textarea {
  width: 100%;
  margin-top: 18rpx;
  min-height: 124rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 84% 16%, rgba(243, 229, 146, 0.05), transparent 18%),
    rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  color: #f3f1e7;
  font-size: 28rpx;
  line-height: 1.65;
}

.ai-entry-question-card__placeholder {
  color: rgba(243, 241, 231, 0.26);
}

.ai-entry-question-card__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ai-entry-question-card__chip {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(243, 241, 231, 0.74);
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
}

.ai-entry-voice-card {
  margin-top: 22rpx;
}

.ai-entry-voice-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-entry-voice-card__title {
  color: #f3f1e7;
  font-size: 34rpx;
  font-weight: 600;
}

.ai-entry-voice-card__sub {
  display: block;
  margin-top: 10rpx;
  color: rgba(243, 241, 231, 0.52);
  font-size: 21rpx;
  line-height: 1.6;
}

.ai-entry-voice-card__orb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(243, 229, 146, 0.14);
  color: #f3f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.ai-entry-voice-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.ai-entry-voice-card__hint {
  flex: 1;
  color: rgba(243, 241, 231, 0.42);
  font-size: 18rpx;
  line-height: 1.5;
}

.ai-entry-voice-card__button {
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1e1b8, #e9c39b);
  color: #17130f;
  font-size: 24rpx;
  font-weight: 600;
}

.ai-entry-result {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  min-height: 420rpx;
  padding: 28rpx;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 76% 18%, rgba(248, 232, 131, 0.54), transparent 22%),
    radial-gradient(circle at 24% 78%, rgba(241, 153, 110, 0.3), transparent 28%),
    linear-gradient(180deg, #86a5b7 0%, #b49787 42%, #e5be79 100%);
}

.ai-entry-result__mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(30rpx);
}

.ai-entry-result__mist--a {
  top: -18rpx;
  right: 18rpx;
  width: 220rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.18);
}

.ai-entry-result__mist--b {
  left: 22rpx;
  bottom: 28rpx;
  width: 220rpx;
  height: 150rpx;
  background: rgba(255, 206, 176, 0.18);
}

.ai-entry-result__eyebrow,
.ai-entry-result__title,
.ai-entry-result__summary,
.ai-entry-result__block {
  position: relative;
  z-index: 1;
}

.ai-entry-result__eyebrow {
  display: block;
  color: rgba(23, 19, 18, 0.46);
  font-size: 18rpx;
  letter-spacing: 1.4rpx;
  text-transform: uppercase;
}

.ai-entry-result__title {
  display: block;
  margin-top: 14rpx;
  color: #171312;
  font-size: 46rpx;
  line-height: 1.12;
  font-weight: 600;
}

.ai-entry-result__summary {
  display: block;
  margin-top: 16rpx;
  color: rgba(23, 19, 18, 0.72);
  font-size: 24rpx;
  line-height: 1.65;
}

.ai-entry-result__block {
  margin-top: 22rpx;
}

.ai-entry-result__label {
  display: block;
  color: rgba(23, 19, 18, 0.48);
  font-size: 20rpx;
}

.ai-entry-result__copy {
  display: block;
  margin-top: 10rpx;
  color: rgba(23, 19, 18, 0.76);
  font-size: 22rpx;
  line-height: 1.6;
}

.ai-entry-result__people {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.ai-entry-result__person {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(23, 19, 18, 0.1);
  color: rgba(23, 19, 18, 0.72);
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
}

.ai-entry-footer {
  position: sticky;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  margin-top: 28rpx;
  display: flex;
  gap: 12rpx;
  padding-bottom: 22rpx;
}

.ai-entry-footer__secondary,
.ai-entry-footer__primary {
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.ai-entry-footer__secondary {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 231, 0.82);
}

.ai-entry-footer__primary {
  flex: 1.15;
  background: linear-gradient(135deg, #f1e1b8, #e9c39b);
  color: #17130f;
  box-shadow: 0 18rpx 36rpx rgba(0, 0, 0, 0.14);
}
